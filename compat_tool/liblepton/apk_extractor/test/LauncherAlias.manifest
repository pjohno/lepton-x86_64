<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.lepton.test.alias">
    <uses-sdk android:minSdkVersion="21" />
    <application>
        <activity android:name=".Target" android:exported="true" />
        <activity-alias android:name=".DisabledLauncher" android:targetActivity=".Target" android:enabled="false" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".Launcher" android:targetActivity=".Target" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
