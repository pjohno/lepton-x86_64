"""Add an Android APK or saved runtime profile as a Steam non-Steam shortcut.

Run with Steam fully exited. Uses Python's standard library only.
Refuses unknown VDF formats rather than overwriting Steam configuration.
"""
import argparse
import json
import os
from pathlib import Path
import re
import shlex
import struct
import sys
import tempfile
import zlib

LEGACY_TOOL = "lepton_x86_64_dev"
LEGACY_INSTALL = Path.home() / ".local/share/lepton-x86_64-dev"
STEAM = Path.home() / ".local/share/Steam"
CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "lepton-x86_64"
GOOGLE_SERVICES_APK = "compat_tool/images/rootfs/system/product/priv-app/PrebuiltGmsCore/PrebuiltGmsCore.apk"


def read_env(path):
    """Parse a KEY=VALUE env file written by lepton-install-bundle."""
    values = {}
    for line in Path(path).read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        parsed = shlex.split(value)
        values[key] = parsed[0] if parsed else ""
    return values


def installed_tool(tool_id):
    """Return (tool, install) for an installed tool ID, or None."""
    env = CONFIG_DIR / (tool_id + ".env")
    if not env.is_file():
        return None
    values = read_env(env)
    return values.get("LEPTON_X86_TOOL_ID", tool_id), Path(values["LEPTON_X86_INSTALL_DIR"])


def default_tool():
    """Pick the install this script belongs to, then the default install, then legacy."""
    try:
        own = Path(__file__).resolve().parents[2]
        metadata = json.loads((own / "BUNDLE.json").read_text(encoding="utf-8"))
        return metadata["tool_id"], own
    except (OSError, ValueError, KeyError, IndexError, NameError):
        pass
    try:
        values = read_env(CONFIG_DIR / "default.env")
        return values["LEPTON_X86_TOOL_ID"], Path(values["LEPTON_X86_INSTALL_DIR"])
    except (OSError, ValueError, KeyError):
        return LEGACY_TOOL, LEGACY_INSTALL


TOOL, INSTALL = default_tool()


def fail(message):
    raise ValueError(message)


def self_contained(install):
    """True if the tool's manifest starts lepton-x86_64-entry (bridge + ADB built in)."""
    try:
        manifest = (install / "compat_tool/toolmanifest.vdf").read_text(encoding="utf-8")
    except OSError:
        return False
    return ("lepton-x86_64-entry" in manifest
            and (install / "compat_tool/lepton-x86_64-entry").is_file())


def steam_running():
    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit():
            continue
        try:
            comm = (entry / "comm").read_text().strip()
        except (OSError, UnicodeError):
            continue
        if comm in {"steam", "steam.sh", "steamwebhelper"}:
            return True
    return False


def cstr(data, index):
    end = data.find(b"\x00", index)
    if end < 0:
        fail("Malformed Steam binary VDF: unterminated string")
    return data[index:end].decode("utf-8"), end + 1


def read_binary(data):
    """Return shortcuts data, existing entry names, and root closing offset."""
    if not data:
        return {}, b"", 0
    if data[:11] != b"\x00shortcuts\x00":
        fail("Unrecognized shortcuts.vdf root; refusing to edit")
    def node(pos):
        fields = {}
        while pos < len(data):
            kind = data[pos]
            pos += 1
            if kind == 8:
                return fields, pos
            key, pos = cstr(data, pos)
            if kind == 0:
                value, pos = node(pos)
            elif kind == 1:
                value, pos = cstr(data, pos)
            elif kind == 2:
                if pos + 4 > len(data): fail("Truncated VDF integer")
                value = struct.unpack_from("<I", data, pos)[0]
                pos += 4
            elif kind == 7:
                if pos + 8 > len(data): fail("Truncated VDF uint64")
                value = struct.unpack_from("<Q", data, pos)[0]
                pos += 8
            else:
                fail("Unsupported VDF field type %s; refusing to edit" % kind)
            fields[key] = value
        fail("Truncated VDF object")
    root, end = node(11)
    # Binary VDF commonly has two trailing 0x08 terminators: one for the
    # "shortcuts" map and another for the implicit outer map. Other writers
    # omit the implicit outer terminator. Accept only these two shapes, and
    # insert new entries before the shortcuts map's own closing byte.
    if data[end:] not in (b"", b"\x08"):
        fail("Unexpected bytes after shortcuts.vdf root")
    return root, data, end - 1


def string(key, value):
    return b"\x01" + key.encode() + b"\x00" + value.encode() + b"\x00"


def integer(key, value):
    return b"\x02" + key.encode() + b"\x00" + struct.pack("<I", value)


def shortcut_entry(slot, appid, name, apk, options, start_dir=None):
    exe = '"' + str(apk) + '"'
    start_dir = '"' + str(start_dir or apk.parent) + '"'
    content = b"\x00" + str(slot).encode() + b"\x00"
    content += integer("appid", appid)
    for key, val in [
        ("AppName", name), ("Exe", exe), ("StartDir", start_dir),
        ("icon", ""), ("ShortcutPath", ""), ("LaunchOptions", options),
    ]:
        content += string(key, val)
    for key, val in [
        ("IsHidden", 0), ("AllowDesktopConfig", 1),
        ("AllowOverlay", 1), ("OpenVR", 0), ("Devkit", 0),
    ]:
        content += integer(key, val)
    content += string("DevkitGameID", "")
    content += integer("DevkitOverrideAppID", 0)
    content += integer("LastPlayTime", 0)
    content += b"\x00tags\x00\x08\x08"
    return content


def block_end(text, start):
    """Index of the brace closing the block opened at text[start]; quoted
    values may contain braces."""
    depth = 0
    quoted = False
    escape = False
    for i in range(start, len(text)):
        c = text[i]
        if quoted:
            if escape: escape = False
            elif c == "\\": escape = True
            elif c == '"': quoted = False
        elif c == '"':
            quoted = True
        elif c == "{":
            depth += 1
        elif c == "}":
            depth -= 1
            if depth == 0:
                return i
    return None


# Where Steam keeps CompatToolMapping in config/config.vdf.
STEAM_SECTION = ("installconfigstore", "software", "valve", "steam")


def find_section(text, path):
    """Index of the "{" opening the nested section path (case-insensitive)."""
    keys = []
    pending = None
    i = 0
    while i < len(text):
        c = text[i]
        if c == '"':
            end = i + 1
            while end < len(text) and text[end] != '"':
                end += 2 if text[end] == "\\" else 1
            value = text[i + 1:end]
            # A string after a key is that key's value; otherwise it is a key.
            pending = None if pending is not None else value
            i = end + 1
            continue
        if c == "{":
            keys.append((pending or "").lower())
            pending = None
            if tuple(keys) == path:
                return i
        elif c == "}":
            if keys: keys.pop()
            pending = None
        i += 1
    return None


def find_mapping_block(text):
    """Find CompatToolMapping's braces, ignoring braces inside quoted values."""
    matches = list(re.finditer(r'"CompatToolMapping"\s*\{', text, re.I))
    if len(matches) != 1:
        fail("Expected one CompatToolMapping block in Steam config.vdf")
    start = text.find("{", matches[0].start())
    end = block_end(text, start)
    if end is None:
        fail("Unterminated CompatToolMapping block")
    return start, end


def with_mapping_block(text):
    """Steam only writes CompatToolMapping once some game has a compatibility
    tool (always on a Steam Deck, often not on a desktop): add an empty one
    where Steam keeps it."""
    if re.search(r'"CompatToolMapping"\s*\{', text, re.I):
        return text, False
    start = find_section(text, STEAM_SECTION)
    end = None if start is None else block_end(text, start)
    if end is None:
        fail("Steam config.vdf has no Software/Valve/Steam section; start Steam once, "
             "exit it, then try again")
    indent = "\t" * len(STEAM_SECTION)
    block = indent + '"CompatToolMapping"\n' + indent + "{\n" + indent + "}\n"
    line = text.rfind("\n", 0, end) + 1
    if text[line:end].strip():
        return text[:end] + "\n" + block + text[end:], True
    return text[:line] + block + text[line:], True


def atomic_replace(path, payload):
    mode = path.stat().st_mode & 0o777 if path.exists() else 0o600
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temp = tempfile.mkstemp(prefix=".lepton-", dir=path.parent)
    try:
        with os.fdopen(fd, "wb") as out:
            out.write(payload)
            out.flush()
            os.fsync(out.fileno())
        os.chmod(temp, mode)
        os.replace(temp, path)
    finally:
        if os.path.exists(temp):
            os.unlink(temp)


def main():
    global TOOL, INSTALL
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("apk", type=Path, help="APK file to add")
    parser.add_argument("--name", help="Name displayed in Steam (default: APK stem)")
    parser.add_argument("--hotplug", action="store_true",
                        help="Enable experimental /dev/input mount and live gamepad hotplug")
    parser.add_argument("--print-appid", action="store_true",
                        help="Print the Steam AppID this shortcut would get, then exit")
    parser.add_argument("--dry-run", action="store_true",
                        help="Validate shortcut and compatibility mapping without modifying Steam files")
    parser.add_argument("--userdata", type=Path,
                        help="Steam userdata/<id> directory (required if multiple users)")
    parser.add_argument("--tool-id", default=TOOL,
                        help="Steam compatibility-tool ID (default: this install, currently %s)" % TOOL)
    parser.add_argument("--install-dir", type=Path,
                        help="Root of the selected tool installation; found automatically for installed tool IDs")
    parser.add_argument("--runtime-profile", help="Launch an existing persistent test profile (APK or APKM), without a compatibility-tool mapping")
    parser.add_argument("--expect-abi", choices=("x86_64", "arm64-v8a"), default="x86_64",
                        help="ABI for --runtime-profile (default: x86_64)")
    args = parser.parse_args()
    if args.runtime_profile:
        if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,63}", args.runtime_profile):
            fail("Invalid runtime profile name")
        if args.install_dir is None:
            args.install_dir = INSTALL
        if args.hotplug:
            fail("Runtime profile shortcuts do not support --hotplug")

    if not re.fullmatch(r"[A-Za-z0-9_]+", args.tool_id):
        fail("Invalid compatibility-tool ID")
    if args.tool_id != TOOL and args.install_dir is None:
        found = installed_tool(args.tool_id)
        if found is None:
            fail("--install-dir is required when selecting another --tool-id "
                 "(no %s found)" % (CONFIG_DIR / (args.tool_id + ".env")))
        args.install_dir = found[1]
    TOOL = args.tool_id
    if args.install_dir is not None:
        INSTALL = args.install_dir.expanduser().resolve(strict=True)
    registration = STEAM / "compatibilitytools.d" / (TOOL + ".vdf")
    if not args.runtime_profile and args.install_dir is not None and registration.is_file():
        # An alternate tool must point at the same install path as its VDF.
        vdf = registration.read_text(encoding="utf-8")
        expected = str(INSTALL / "compat_tool")
        if not re.search(r'"install_path"\s*"' + re.escape(expected) + r'"', vdf):
            fail("Tool registration install_path does not match --install-dir")

    apk = args.apk.expanduser().resolve(strict=True)
    # Lepton installs split-APK bundles (.apkm) on the normal launch path too.
    if not apk.is_file() or apk.suffix.lower() not in {".apk", ".apkm"}:
        fail("Expected an existing .apk or .apkm file")
    if args.print_appid:
        # The Steam AppID (and so compatdata/<appid>) this shortcut will get;
        # used to prepare a game's data before its shortcut exists.
        name = args.name or apk.stem
        print(zlib.crc32(('"' + str(apk) + '"' + name).encode("utf-8")) | 0x80000000)
        return
    if args.runtime_profile:
        runner = INSTALL / "tests/runtime/run-apk.sh"
        profile = INSTALL / (".runtime-profile." + args.runtime_profile)
        if not runner.is_file() or not (profile / "profile-fingerprint").is_file():
            fail("Runtime runner or saved profile missing; complete setup first")
    # Never close or start Steam from here: the user exits Steam themselves.
    # A dry run only reads Steam's files, so it is allowed while Steam runs.
    if not args.dry_run and steam_running():
        fail("Steam is still running. Exit Steam completely (Steam menu > Exit), "
             "then try again. Nothing was changed.")
    if not (INSTALL / "compat_tool/tools/lepton-gamescope-bridge").is_file():
        fail("Lepton installation not found at " + str(INSTALL))
    if not args.runtime_profile and not (STEAM / "compatibilitytools.d" / (TOOL + ".vdf")).is_file():
        fail("Lepton is not registered with Steam; install the .vdf and restart Steam")
    name = args.name or apk.stem
    if not name or any(x in name for x in "\x00\r\n"):
        fail("Invalid shortcut name")
    userdata = STEAM / "userdata"
    users = sorted(p for p in userdata.iterdir()
                   if p.is_dir() and p.name.isdigit())
    if args.userdata:
        selected = args.userdata.expanduser().resolve()
        if selected not in [p.resolve() for p in users]:
            fail("--userdata must point to an existing numeric Steam user directory")
    elif len(users) == 1:
        selected = users[0]
    else:
        fail("Found %d Steam users; specify --userdata" % len(users))
    shortcuts = selected / "config/shortcuts.vdf"
    config = STEAM / "config/config.vdf"
    if not config.is_file():
        fail("Steam config.vdf not found")
    original = shortcuts.read_bytes() if shortcuts.exists() else b""
    entries, data, insertion = read_binary(original)
    executable = Path("/usr/bin/bash") if args.runtime_profile else apk
    exe = '"' + str(executable) + '"'
    for value in entries.values():
        if not isinstance(value, dict) or value.get("Exe") != exe:
            continue
        if not args.runtime_profile or (
            str(INSTALL / "tests/runtime/run-apk.sh") in value.get("LaunchOptions", "")
            and ("--profile " + args.runtime_profile + " ") in value.get("LaunchOptions", "")
        ):
            # Steam can take a while to save a deleted shortcut (in practice
            # sometimes only after a restart of the Deck).
            fail("A shortcut for this APK/profile already exists: " + value.get("AppName", str(apk))
                 + "\nIf you have deleted it in Steam, Steam may not have saved that yet: "
                 "restart the Steam Deck and try again (or copy the file to another folder).")
    slot = 0
    while str(slot) in entries:
        slot += 1
    appid = zlib.crc32((exe + name).encode("utf-8")) | 0x80000000
    for value in entries.values():
        if isinstance(value, dict) and value.get("appid") == appid:
            fail("Shortcut AppID collision; try a different --name")

    legacy_options = (
        "APP_WANTS_FLATSCREEN=true "
        + ("LEPTON_GAMEPAD_HOTPLUG=true " if args.hotplug else "")
        + "LEPTON_ADB=" + shlex.quote(str(INSTALL / "tools/platform-tools/adb")) + " "
        + "PATH=" + shlex.quote(str(INSTALL / "tools/bin")) + ":$PATH "
        + shlex.quote(str(INSTALL / "compat_tool/tools/lepton-gamescope-bridge")) + " %command%"
    )
    if args.runtime_profile:
        # Saved profiles run a specific install's runner (no compatibility tool).
        options = legacy_options + " " + shlex.join([
            str(runner), "--stage-dir", str(INSTALL), "--apk", str(apk),
            "--expect-abi", args.expect_abi, "--app", "--profile", args.runtime_profile,
            "--rendering", "amd", "--display", "desktop", "--network-sysctls",
            "--until-exit", "--execute",
        ])
    elif self_contained(INSTALL):
        # The tool supplies its bridge, ADB and flatscreen default itself, so
        # switching the game's compatibility tool in Steam switches everything.
        options = "LEPTON_GAMEPAD_HOTPLUG=true %command%" if args.hotplug else ""
    else:
        options = legacy_options  # older installs without lepton-x86_64-entry
    new_shortcuts = data[:insertion] + shortcut_entry(
        slot, appid, name, executable, options, INSTALL if args.runtime_profile else None
    ) + (data[insertion:] if data else b"\x08")
    if not data:
        # Include the conventional implicit outer map terminator as well.
        new_shortcuts = b"\x00shortcuts\x00" + new_shortcuts + b"\x08"

    new_config = None
    notes = []
    if not args.runtime_profile:
        # Steam keeps a deleted shortcut's game data (compatdata/<AppID>), and
        # the same APK path + name gives the same AppID, so a re-added game
        # continues with that data.
        data_dir = STEAM / "steamapps/compatdata" / str(appid)
        if data_dir.is_dir():
            if ((data_dir / "lepton-google-game").is_file()
                    and not (INSTALL / GOOGLE_SERVICES_APK).is_file()):
                fail("A deleted shortcut with this name saved this game as a Google game, "
                     "but " + TOOL + " has no Google services. Add it with a Lepton GApps "
                     "tool, or use a different name to start with fresh game data.")
            notes.append("Reusing the saved game data of an earlier shortcut with this name "
                         "(" + str(data_dir) + "); use a different name to start fresh.")
        original_config = config.read_bytes()
        decoded, created = with_mapping_block(original_config.decode("utf-8"))
        if created:
            notes.append("Added Steam's compatibility-tool list (first game with a compatibility tool).")
        start, end = find_mapping_block(decoded)
        if re.search(r'"\s*' + str(appid) + r'\s*"\s*\{', decoded[start:end]):
            # No shortcut has this AppID (checked above), so this mapping was
            # left behind when the shortcut was deleted in Steam: replace it.
            leftover = re.search(r'"\s*' + str(appid) + r'\s*"\s*\{[^{}]*\}', decoded[start:end])
            if not leftover:
                fail("Steam config has an unexpected mapping for this AppID; refusing to overwrite")
            previous = re.search(r'"name"\s*"([^"]*)"', leftover.group(0))
            notes.append("Replacing the compatibility tool left by a deleted shortcut ("
                         + (previous.group(1) if previous and previous.group(1) else "none")
                         + ") with " + TOOL + ".")
            decoded = decoded[:start + leftover.start()] + decoded[start + leftover.end():]
            start, end = find_mapping_block(decoded)
        new_mapping = (
            '\n\t\t\t\t\t\t"' + str(appid) + '"\n'
            '\t\t\t\t\t\t{\n'
            '\t\t\t\t\t\t\t"name"\t\t"' + TOOL + '"\n'
            '\t\t\t\t\t\t\t"config"\t\t""\n'
            '\t\t\t\t\t\t\t"priority"\t\t"250"\n'
            '\t\t\t\t\t\t}\n'
        )
        new_config = (decoded[:end] + new_mapping + decoded[end:]).encode("utf-8")
    if args.dry_run:
        print("PASS: shortcut is valid; no Steam files modified" if args.runtime_profile else "PASS: shortcut and compatibility mapping are valid; no Steam files modified")
        print("Proposed shortcut:", name, "| Steam AppID:", appid)
        print("Hotplug:", "enabled (experimental)" if args.hotplug else "off")
        for note in notes:
            print("Note:", note)
        return
    # Each replacement is atomic. If the second write fails, restore the
    # first file, including the original absence of shortcuts.vdf.
    atomic_replace(shortcuts, new_shortcuts)
    try:
        if new_config is not None:
            atomic_replace(config, new_config)
    except Exception:
        if original:
            atomic_replace(shortcuts, original)
        else:
            shortcuts.unlink(missing_ok=True)
        raise
    print("Added Steam shortcut:", name)
    print("APK:", apk)
    print("Steam AppID:", appid)
    print("Saved runtime profile:" if args.runtime_profile else "Compatibility tool:", args.runtime_profile or TOOL)
    print("Hotplug:", "enabled (experimental)" if args.hotplug else "off (safe startup mounts)")
    for note in notes:
        print("Note:", note)
    print("It is now safe to start Steam again; the game is under Non-Steam games.")
    print("Steam Input native touchscreen layout must be enabled manually.")


if __name__ == "__main__":
    try:
        main()
    except (ValueError, OSError, UnicodeError) as exc:
        print("ERROR:", exc, file=sys.stderr)
        sys.exit(1)
