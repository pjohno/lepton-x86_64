"""Internal bridge between the compatibility launcher and the Android Library.

Messages for the user go to stderr. Values for the launcher go to stdout.
"""
import argparse
import contextlib
import hashlib
from pathlib import Path, PurePosixPath
import os
import re
import shutil
import subprocess
import sys
import time
import zipfile

import lepton_library as lib

CHUNK = 1 << 20
PODMAN_SETTINGS = {"PATH", "HOME", "USER", "LOGNAME", "TMPDIR", "XDG_RUNTIME_DIR", "XDG_CONFIG_HOME",
                   "XDG_DATA_HOME", "XDG_CACHE_HOME", "DBUS_SESSION_BUS_ADDRESS"}


def podman_environment():
    """Podman's own settings only, as lepton_podman_environment in liblepton.sh."""
    return {key: value for key, value in os.environ.items()
            if key in PODMAN_SETTINGS or key.startswith(("CONTAINERS_", "CONTAINER_", "PODMAN_"))}


class Rejected(ValueError):
    """Android's package manager refused the package. Retrying the same files
    cannot succeed, unlike an interrupted or timed-out installation."""


class Android:
    def __init__(self, context):
        self.context = "lepton-" + context
        self.timeout = int(os.environ.get("LEPTON_APP_INSTALL_TIMEOUT", "600"))
        if self.timeout <= 0:
            raise ValueError("Invalid Android install timeout")

    def argv(self, *args, stdin=False):
        # cmd_real is Android's own cmd. The Lepton cmd wrapper moves app code
        # into the legacy baked overlay after installation.
        return ["podman", "exec", *(["-i"] if stdin else []), self.context, *args]

    def run(self, *args, timeout=30):
        return subprocess.run(self.argv(*args), stdin=subprocess.DEVNULL, text=True, stdout=subprocess.PIPE,
                              stderr=subprocess.PIPE, timeout=timeout, env=podman_environment())

    def checked(self, *args, timeout=30):
        result = self.run(*args, timeout=timeout)
        if result.returncode:
            raise ValueError(result.stdout.strip() or result.stderr.strip() or f"Android command failed: {args[0]}")
        return result.stdout.strip()

    def pm(self, *args, **kwargs):
        return self.checked("/system/bin/cmd_real", "package", *args, **kwargs)

    def wait_ready(self):
        deadline = time.monotonic() + 60
        while time.monotonic() < deadline:
            try:
                result = self.run("/system/bin/cmd_real", "package", "path", "android", timeout=5)
            except subprocess.TimeoutExpired:
                continue
            if result.returncode == 0 and result.stdout.startswith("package:"):
                return
            time.sleep(1)
        raise ValueError("Android package manager did not become ready")

    def installed(self, package):
        """{"code": {version_code, base, splits}, "dir": code directory}, or None."""
        result = self.run("/system/bin/cmd_real", "package", "path", "--user", "0", package)
        lines = result.stdout.splitlines()
        if result.returncode == 1 and not lines and not result.stderr.strip():
            return None
        if result.returncode or not lines or any(not line.startswith("package:/data/app/") for line in lines):
            raise ValueError(f"Cannot establish the Android code paths for {package}")
        paths = [line.removeprefix("package:") for line in lines]
        if (len(set(paths)) != len(paths) or any(".." in PurePosixPath(path).parts or
                not re.fullmatch(r"/data/app/(?:[A-Za-z0-9_.=~-]+/)+[A-Za-z0-9_.-]+\.apk", path)
                for path in paths)):
            raise ValueError("Invalid Android code paths")
        hashes = {}
        for path in paths:
            digest = self.checked("/system/bin/toybox", "sha256sum", path).split()[0]
            if not lib.DIGEST.fullmatch(digest):
                raise ValueError(f"Cannot hash installed APK {path}")
            hashes[PurePosixPath(path).name] = digest
        output = self.checked("/system/bin/dumpsys", "package", package)
        # dumpsys prints the long version code, which can be negative when
        # versionCodeMajor is negative.
        version = re.search(r"(?m)^\s*versionCode=(-?\d+)\b", output)
        if not version or "base.apk" not in hashes or len(hashes) != len(paths):
            raise ValueError(f"Cannot verify the installed version of {package}")
        directory = str(PurePosixPath(next(path for path in paths if path.endswith("/base.apk"))).parent)
        base = hashes.pop("base.apk")
        return {"code": {"version_code": int(version[1]), "base": base, "splits": sorted(hashes.values())},
                "dir": directory}

    def abandon(self, session):
        if not isinstance(session, str) or not re.fullmatch(r"[0-9]+", session):
            raise ValueError("Invalid pending package-manager session")
        # A committed session may have disappeared by the time we recover.
        result = self.run("/system/bin/cmd_real", "package", "install-abandon", session, timeout=5)
        if result.returncode and "session" not in (result.stdout + result.stderr).lower():
            raise ValueError("Could not abandon the interrupted installation session")

    def upload(self, session, source):
        """Stream one APK into the session, checking its digest on the way."""
        name, size, digest, opener = source
        process = subprocess.Popen(
            self.argv("/system/bin/cmd_real", "package", "install-write", "-S", str(size), session, name, "-",
                      stdin=True), stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            env=podman_environment())
        hasher = hashlib.sha256()
        try:
            with opener() as stream:
                while chunk := stream.read(CHUNK):
                    hasher.update(chunk)
                    process.stdin.write(chunk)
            process.stdin.close()
            output, errors = process.communicate(timeout=self.timeout)
        except BaseException:
            process.kill()
            process.wait()
            raise
        text = output.decode(errors="replace").strip()
        if process.returncode or not text.startswith("Success"):
            raise ValueError(f"Package upload failed: {text or errors.decode(errors='replace').strip()}")
        if hasher.hexdigest() != digest:
            raise ValueError(f"{name} changed while it was being installed")

    def install(self, sources, on_created):
        # -g grants requested runtime permissions, as Lepton's unmanaged
        # installs do, so a game is not stopped at a permission prompt.
        result = self.pm("install-create", "-r", "-g", "--user", "0", timeout=self.timeout)
        session = re.fullmatch(r"Success: created install session \[(\d+)\]", result)
        if not session:
            raise ValueError(f"Cannot create package replacement session: {result}")
        session = session[1]
        committed = False
        try:
            on_created(session)
            for source in sources:
                self.upload(session, source)
            result = self.run("/system/bin/cmd_real", "package", "install-commit", session, timeout=self.timeout)
            output = (result.stdout.strip() or result.stderr.strip())
            if result.returncode or output != "Success":
                if output.startswith("Failure"):
                    raise Rejected(output)
                raise ValueError(f"Android installation did not finish: {output}")
            committed = True
        finally:
            if not committed:
                try:
                    self.abandon(session)
                except (ValueError, subprocess.TimeoutExpired):
                    pass

    def obb(self, package, *, check=False):
        self.checked("/system/bin/sh", "-c", '''
            path="/data/media/0/Android/obb/$1"
            target="/lepton/managed-obb"
            if [ -L "$path" ]; then
                [ "$(readlink "$path")" = "$target" ] || exit 1
            elif [ -e "$path" ]; then
                # Replace only an empty real directory created by Android.
                if [ "$2" = check ]; then
                    [ -d "$path" ] && [ -z "$(ls -A "$path")" ] || exit 1
                else
                    rmdir "$path" && ln -s "$target" "$path" || exit 1
                fi
            elif [ "$2" != check ]; then
                mkdir -p "${path%/*}" && ln -s "$target" "$path" || exit 1
            fi
        ''', "lepton-obb", package, "check" if check else "link")


def install_sources(config, apk):
    """[(name, size, sha256, opener)] for the APKs Android receives: the base
    and, for an APKM, the splits for this machine's ABI."""
    if config["format"] == ".apk":
        return [("base.apk", apk.stat().st_size, config["apks"]["base.apk"], lambda: apk.open("rb"))]
    sources = []
    with zipfile.ZipFile(apk) as bundle:
        members = {entry.filename: entry for entry in bundle.infolist()}
    names = lib.selected_apkm_names(config["apks"])[0]
    for name in sorted(names):
        if name not in members:
            raise ValueError(f"{apk.name} lacks {name}")

        @contextlib.contextmanager
        def opener(name=name):
            with zipfile.ZipFile(apk) as bundle, bundle.open(name) as stream:
                yield stream
        sources.append((name, members[name].file_size, config["apks"][name], opener))
    return sources


def target_code(config):
    """The installed-code identity Android should report for CONFIG."""
    names = lib.selected_apkm_names(config["apks"])[0] if config["format"] == ".apkm" else {"base.apk"}
    if "base.apk" not in names or any(name not in config["apks"] for name in names):
        raise ValueError("Library metadata lacks the APKs selected for installation")
    return {"version_code": config["version_code"], "base": config["apks"]["base.apk"],
            "splits": sorted(config["apks"][name] for name in names if name != "base.apk")}


def reconcile(android, state, package, save):
    """Bring the receipt in line with Android after an interrupted launch.
    Returns the live installation (or None)."""
    live = android.installed(package)
    code = live and live["code"]
    old, pending = state.get("installed"), state.get("pending")
    if pending is not None and code == pending["code"]:
        # Android committed before the receipt was written.
        state.update(installed=pending, pending=None)
    elif code != (old["code"] if old else None):
        raise ValueError("Installed Android code differs from the last verified state. Profile preserved.")
    if state.get("session") is not None:
        android.abandon(state["session"])
        state.pop("session")
    state["pending"] = None
    save()
    return live


def finish_install(android, state, target, sources, package, save):
    """Journal before the PM commit; verify the result before recording it.
    Returns "current", "installed", or "newer" when the profile keeps a newer
    version than TARGET (Android never downgrades it)."""
    old = state.get("installed")
    if old == target:
        return "current"
    if old and target["code"]["version_code"] < old["code"]["version_code"]:
        return "newer"

    def record_session(session):
        state["session"] = session
        save()

    state.update(pending=target)
    save()
    android.install(sources, record_session)
    live = android.installed(package)
    if not live or live["code"] != target["code"]:
        raise ValueError("Android installed code or version differs from the requested replacement")
    android.checked("/system/bin/toybox", "sync")
    state.update(installed=target, pending=None)
    state.pop("session", None)
    save()
    return "installed"


def describe(config):
    return f"{config['version_name'] or 'version'} ({config['version_code']})"


def profile_install(root, package, baked, context, obb):
    directory = root / package
    lib.real_dir(directory)
    lib.real_dir(baked)
    receipt = baked / "lepton-managed.json"
    state = lib.read_json(receipt)
    if state["package"] != package:
        raise ValueError("Managed profile belongs to another package")
    android = Android(context)
    index = directory / ".profiles"
    record = index / (lib.profile_key(baked) + ".json")
    kind = "standalone" if os.environ.get("LEPTON_STANDALONE_PROFILE") == "1" else "steam"
    attempted = {}

    def report(status, error=None):
        installed = state.get("installed") or {}
        lib.atomic_json(record, dict(
            schema_version=1, context=context, profile=str(baked.parent), kind=kind, state=status,
            installed_revision=installed.get("revision"),
            installed_version=installed.get("code", {}).get("version_code"),
            attempted_revision=attempted.get("revision"), attempted_version=attempted.get("version_code"),
            error=error, time=int(time.time())))

    # One launch at a time changes an app's library files; a second profile
    # of the same app waits for the first installation to finish.
    with lib.lock(directory, True, wait=android.timeout):
        if lib.exists(directory / lib.JOURNAL):
            lib.commit_update(directory)
            print(f"Finished an interrupted library update for {package}", file=sys.stderr)
        _, config, apk = lib.load_app(root, package, verify=True)
        candidate = lib.load_candidate(directory, config, verify=True)
        index.mkdir(mode=0o700, exist_ok=True)
        lib.real_dir(index)
        save = lambda: lib.atomic_json(receipt, state)  # noqa: E731
        try:
            report("applying")
            android.wait_ready()
            if obb:
                try:
                    android.obb(package, check=True)
                except ValueError as exc:
                    raise ValueError("Existing Android OBB path is occupied. Move its files to safety before "
                                     "attaching library OBBs.") from exc
            live = reconcile(android, state, package, save)
            usable = candidate if candidate and not candidate["rejected"] else None
            chosen, files = (usable["config"], usable["apk"]) if usable else (config, apk)
            attempted.update(revision=chosen["revision"], version_code=chosen["version_code"])
            target = {"revision": chosen["revision"], "code": target_code(chosen)}
            try:
                result = finish_install(android, state, target, install_sources(chosen, files), package, save)
            except Rejected as exc:
                if not usable:
                    raise
                lib.reject_candidate(directory, chosen["revision"], str(exc))
                installed = state.get("installed")
                kept = f"version {installed['code']['version_code']}" if installed else "the previous state"
                raise ValueError(f"Android refused the update to {describe(chosen)}: {exc}. {package} "
                                 f"{kept} and its data are unchanged; launch again to play it. Run "
                                 f"lepton-library info {package} for details.") from exc
            if result == "newer":
                print(f"WARNING: this profile keeps {package} version {state['installed']['code']['version_code']}, "
                      f"which is newer than the library's {describe(chosen)}. Android does not downgrade apps.",
                      file=sys.stderr)
            elif usable:
                lib.promote_candidate(directory)
                print(f"Android accepted {package} {describe(chosen)}; it is now the library version",
                      file=sys.stderr)
            if obb:
                android.obb(package)
            report("newer" if result == "newer" else "applied")
        except (ValueError, OSError, subprocess.TimeoutExpired) as exc:
            report("failed", str(exc))
            raise
    live = android.installed(package)
    if result != "newer":
        print(f"Verified {package} {describe(chosen)} in {baked.parent}", file=sys.stderr)
    # For NDK preparation: where Android put the code, and its identity.
    print(live["dir"])
    print(hashlib.sha256(repr(sorted(live["code"].items())).encode()).hexdigest())


def install_pending(root, package, baked):
    """True when this launch will ask Android to install or replace code."""
    directory, config, _ = lib.load_app(root, package)
    candidate = lib.load_candidate(directory, config)
    chosen = candidate["config"] if candidate and not candidate["rejected"] else config
    try:
        installed = lib.read_json(baked / "lepton-managed.json").get("installed") or {}
    except (OSError, ValueError):
        return True
    if installed.get("revision") == chosen["revision"]:
        return False
    # A profile newer than the library keeps its version (finish_install).
    return installed.get("code", {}).get("version_code", chosen["version_code"]) <= chosen["version_code"]


def unpack_apkm(path, cache):
    with zipfile.ZipFile(path) as bundle:
        apks = [entry.filename for entry in bundle.infolist() if entry.filename.endswith(".apk")]
        if ("base.apk" not in apks or len(set(apks)) != len(apks) or
                any(not re.fullmatch(r"[A-Za-z0-9_.-]+\.apk", name) for name in apks)):
            raise ValueError("APKM needs exactly one base.apk and safe split names")
        selected, abi = lib.selected_apkm_names(apks)
        cache.mkdir()
        for name in sorted(selected):
            with bundle.open(name) as src, (cache / name).open("xb") as dst:
                shutil.copyfileobj(src, dst)
        (cache / "lepton-abi").write_text((abi or "none").replace("_v8a", "-v8a") + "\n")


def location():
    """Line 1: configured library path (empty if none). Line 2: "available",
    or the reason it is not. Never fails for an unavailable library."""
    found = lib.configured()
    if found is None:
        print()
        print("not configured")
        return
    print(found[0])
    try:
        lib.check_available(*found)
        print("available")
    except lib.Unavailable as exc:
        print(str(exc).replace("\n", " "))


def main():
    parser = argparse.ArgumentParser()
    actions = parser.add_subparsers(dest="action", required=True)
    actions.add_parser("location")
    unpack = actions.add_parser("unpack")
    unpack.add_argument("archive", type=Path)
    unpack.add_argument("cache", type=Path)
    app = actions.add_parser("app")
    app.add_argument("target")
    profile = actions.add_parser("profile")
    profile.add_argument("baked", type=Path)
    profile.add_argument("package")
    profile.add_argument("mode", choices=("new", "existing"))
    for name in ("install", "pending"):
        action = actions.add_parser(name)
        action.add_argument("root", type=Path)
        action.add_argument("package")
        action.add_argument("baked", type=Path)
        if name == "install":
            action.add_argument("context")
            action.add_argument("--obb", action="store_true")
    args = parser.parse_args()
    if args.action == "location":
        location()
    elif args.action == "unpack":
        unpack_apkm(args.archive, args.cache)
    elif args.action == "app":
        root = lib.library()
        app = lib.runtime_app(root, args.target) if root is not None else None
        if app:
            sharing, directory, obb, activity = app
            print(directory)
            print(obb)
            print(activity)
            print(sharing or "")
    elif args.action == "profile":
        baked = args.baked.resolve()
        path = baked / "lepton-managed.json"
        if args.mode == "new":
            lib.atomic_json(path, dict(schema_version=1, package=args.package, installed=None, pending=None))
        elif not path.is_file() or lib.read_json(path)["package"] != args.package:
            raise ValueError("This profile was created by an unmanaged launch of the APK. Its data is kept; "
                             "launch the original APK file to use it, or use a new profile for the library app.")
    elif args.action == "pending":
        sys.exit(0 if install_pending(args.root, args.package, args.baked.resolve()) else 1)
    else:
        profile_install(args.root, args.package, args.baked.resolve(), args.context, args.obb)


if __name__ == "__main__":
    try:
        main()
    except (ValueError, OSError, KeyError, TypeError, subprocess.TimeoutExpired, zipfile.BadZipFile) as exc:
        sys.exit(f"Android Library: {exc}")
