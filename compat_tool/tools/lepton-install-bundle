#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Install a Lepton x86_64 Steam Deck bundle for the current user.
#
#   bash lepton-x86_64-ID.install.sh            # install
#   bash lepton-x86_64-ID.install.sh --check    # verify only
#   bash lepton-x86_64-ID.install.sh --replace  # overwrite this tool's install
#   bash lepton-x86_64-ID.install.sh --into OLD_TOOL_ID   # overwrite another
#   bash lepton-x86_64-ID.install.sh --remove OLD_TOOL_ID # remove after install
#
# Steps: verify checksum, extract, download Google's ADB (needs internet),
# move into ~/.local/share/<install_directory>, register the Steam
# compatibility tool, and write ~/.config/lepton-x86_64/<tool_id>.env.
#
# Google's Android Platform-Tools are not part of the Lepton bundle. This
# installer downloads the official versioned ZIP from Google on this machine,
# extracts only adb and NOTICE.txt, and accepts adb only if it matches the
# pinned SHA256 and version, before anything is moved into place. Keep this
# pin identical to image-14/scripts/internal/provision-deck-tools.sh.
set -Eeuo pipefail

ADB_URL='https://dl.google.com/android/repository/platform-tools_r37.0.1-linux.zip'
ADB_SHA256='a902be8f45c6c62e76c9efaf6947a0fa747c9cabd89a2ac8e0d16ecb30b3ed01'
ADB_VERSION='37.0.1-15733141'
ADB_ZIP=''

# Packaging substitutes the archive name; an explicit ARCHIVE argument wins.
DEFAULT_ARCHIVE=''
INSTALL_PROFILE=''
ORIG_ARGS=("$@")
MODE=execute
PAUSE=false
REPLACE=false
NEW=false
INTO=''
REMOVE_IDS=()
KEEP_PREVIOUS=false
ALLOW_NON_AMD=false
ARCHIVE=''

fail() { printf '[FAIL] %s\n' "$*" >&2; exit 1; }
info() { printf '[INFO] %s\n' "$*"; }
pass() { printf '[PASS] %s\n' "$*"; }
usage() {
    sed -n '3,14p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
    cat <<'HELP'
Options:
  --install-profile local-desktop|steamos
                   Override OS detection: direct Wayland or Gamescope bridge
  --detect-profile Print the selected profile and exit (no host checks or writes)
  --check          Verify the archive and destination; change nothing
  --replace        Overwrite an existing install of this bundle's own tool ID
  --new            Install as a new tool without asking (fails if this bundle's
                   tool ID is already installed); used by the release manager
  --into TOOL_ID   Overwrite another existing install (e.g. lepton_x86_64_dev).
                   Its tool ID and directory are kept, so its Steam shortcuts
                   keep working; Steam shows the new name after a restart
  --keep-previous  With --replace/--into: keep the old copy as <dir>.previous-<date>
  --remove TOOL_ID Remove another install after a successful install (repeatable;
                   see lepton-manage-installs --list)
  --allow-non-amd  Install on a host without an AMD GPU (software rendering only)
  --pause          End with "Press Enter to close" (used by desktop icons)
  --adb-zip FILE   Use an already downloaded copy of Google's official
                   platform-tools_r37.0.1-linux.zip instead of downloading it
                   (its adb must still match the pinned SHA256 and version)
  ARCHIVE          Bundle .tar.gz (default: the archive next to this script)
HELP
}
# Set up cleanup and the optional close prompt before parsing, so even an
# invalid option leaves a readable window when --pause is in effect.
TEMP=''
ADB_WORK=''
cleanup() {
    [[ -z "${ADB_WORK:-}" ]] || rm -rf -- "$ADB_WORK"
    [[ -n "${TEMP:-}" ]] && rm -f -- "$TEMP.meta"
    [[ -z "${TEMP:-}" || ! -d "$TEMP" ]] && return
    chmod -R u+rwX -- "$TEMP" 2>/dev/null || true
    rm -rf -- "$TEMP"
}
# In a terminal window opened for the user, end with an explicit close prompt.
pause_window() {
    local status="$1" seconds=60
    printf '\n'
    if [[ "$status" == 0 ]]; then
        printf '[DONE] Finished successfully.\n'
    else
        printf '[FAIL] Did not complete; see the messages above.\n'
        seconds=600
    fi
    printf 'Press Enter to close this window (it closes by itself in %s seconds).\n' "$seconds"
    read -r -t "$seconds" _ || true
}
finish() {
    local status=$?
    trap - EXIT
    cleanup
    [[ "$PAUSE" == false ]] || pause_window "$status"
    exit "$status"
}
trap finish EXIT

while (($#)); do
    case "$1" in
        --install-profile)
            INSTALL_PROFILE="${2:?--install-profile needs local-desktop or steamos}"
            case "$INSTALL_PROFILE" in local-desktop|steamos) ;; *) fail "Unknown installation profile: $INSTALL_PROFILE" ;; esac
            shift 2 ;;
        --detect-profile) MODE=detect-profile; shift ;;
        --check) MODE=check; shift ;;
        --replace) REPLACE=true; shift ;;
        --new) NEW=true; shift ;;
        --into) INTO="${2:?--into needs a tool ID}"; shift 2 ;;
        --remove) REMOVE_IDS+=("${2:?--remove needs a tool ID}"); shift 2 ;;
        --keep-previous) KEEP_PREVIOUS=true; shift ;;
        --allow-non-amd) ALLOW_NON_AMD=true; shift ;;
        --adb-zip) ADB_ZIP="${2:?--adb-zip needs a ZIP file}"; shift 2 ;;
        --pause) PAUSE=true; shift ;;
        -h|--help) usage; exit 0 ;;
        -*) fail "Unknown option: $1" ;;
        *) [[ -z "$ARCHIVE" ]] || fail 'Only one archive may be given'; ARCHIVE="$1"; shift ;;
    esac
done
[[ "$NEW" == false || ( "$REPLACE" == false && -z "$INTO" ) ]] || fail '--new cannot be combined with --replace or --into'

# Keep detection inside the installer: transferred .install.sh files need no
# source checkout. Other host tools use --detect-profile for the same policy.
# Fixture paths let tests simulate hosts without changing the real OS files.
os_release="${LEPTON_HOST_OS_RELEASE:-/etc/os-release}"
[[ -r "$os_release" ]] || os_release="${LEPTON_HOST_OS_RELEASE_FALLBACK:-/usr/lib/os-release}"
os_id=''
os_name='Unknown Linux'
pretty_name=''
if [[ -r "$os_release" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ "$line" =~ ^(ID|NAME|PRETTY_NAME)=(.*)$ ]] || continue
        key="${BASH_REMATCH[1]}"; value="${BASH_REMATCH[2]}"
        # Remove paired quotes as data only. Never source/eval os-release.
        if [[ "$value" == \"*\" ]]; then
            value="${value:1:${#value}-2}"
        elif [[ "$value" == \'*\' ]]; then
            value="${value:1:${#value}-2}"
        fi
        case "$key" in
            ID) os_id="$value" ;;
            NAME) os_name="$value" ;;
            PRETTY_NAME) pretty_name="$value" ;;
        esac
    done < "$os_release"
fi
if [[ -z "$INSTALL_PROFILE" ]]; then
    if [[ "$os_id" == steamos ]]; then INSTALL_PROFILE=steamos; else INSTALL_PROFILE=local-desktop; fi
fi
if [[ "$MODE" == detect-profile ]]; then
    printf '%s\n' "$INSTALL_PROFILE"
    exit 0
fi
pass "Detected ${pretty_name:-$os_name}"
pass "Installation profile: $INSTALL_PROFILE"
if [[ "$INSTALL_PROFILE" == steamos ]]; then
    pass 'Launcher: Gamescope bridge'
    pass 'Steam Deck Gaming/Desktop modes preserved'
else
    pass 'Launcher: direct Wayland'
    pass 'Default display mode: native fullscreen'
fi

# Double-clicked in a file manager: reopen in a terminal so progress is visible.
if [[ ! -t 0 && ! -t 1 && -z "${LEPTON_INSTALL_IN_TERMINAL:-}" &&
      ( -n "${WAYLAND_DISPLAY:-}" || -n "${DISPLAY:-}" ) ]] && command -v konsole >/dev/null 2>&1; then
    export LEPTON_INSTALL_IN_TERMINAL=1
    exec konsole -e bash "$(realpath -e -- "${BASH_SOURCE[0]}")" --pause "${ORIG_ARGS[@]}"
fi


[[ $(id -u) -ne 0 ]] || fail 'Run as your normal user (deck), without sudo'
[[ $(uname -m) == x86_64 ]] || fail 'This bundle requires an x86_64 host'
for program in tar gzip sha256sum python3 realpath mktemp timeout; do
    command -v "$program" >/dev/null || fail "Missing required program: $program"
done
if [[ -n "$ADB_ZIP" ]]; then
    [[ -f "$ADB_ZIP" ]] || fail "ADB ZIP not found: $ADB_ZIP"
    ADB_ZIP="$(realpath -e -- "$ADB_ZIP")"
else
    command -v curl >/dev/null || fail 'Missing required program: curl (needed to download ADB from Google)'
fi

here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
if [[ -z "$ARCHIVE" ]]; then
    [[ -n "$DEFAULT_ARCHIVE" ]] || fail 'Give the bundle .tar.gz path as an argument'
    ARCHIVE="$here/$DEFAULT_ARCHIVE"
fi
ARCHIVE="$(realpath -e -- "$ARCHIVE")" || fail "Archive not found: $ARCHIVE"
[[ "$ARCHIVE" == *.tar.gz && -f "$ARCHIVE" ]] || fail 'Expected a .tar.gz bundle'
CHECKSUM="$ARCHIVE.sha256"
[[ -f "$CHECKSUM" ]] || fail "Checksum file missing: $CHECKSUM (copy it next to the archive)"

info "Verifying $(basename -- "$ARCHIVE") (this reads the whole archive)"
( cd "$(dirname -- "$ARCHIVE")" && sha256sum --check --ignore-missing --quiet "$(basename -- "$CHECKSUM")" ) ||
    fail 'Checksum verification failed; re-transfer the bundle'
grep -Fq " $(basename -- "$ARCHIVE")" "$CHECKSUM" || grep -Fq "*$(basename -- "$ARCHIVE")" "$CHECKSUM" ||
    fail 'Checksum file does not list this archive'
pass 'Archive checksum verified'

amd=false intel=false
for vendor_file in "${LEPTON_SYSFS_DRM:-/sys/class/drm}"/renderD*/device/vendor; do
    [[ -r "$vendor_file" && "$(<"$vendor_file")" == 0x1002 ]] && amd=true
    [[ -r "$vendor_file" && "$(<"$vendor_file")" == 0x8086 ]] && intel=true
done
bundle_has_intel=false
if [[ "$amd" != true && "$intel" == true ]] &&
    tar -tzf "$ARCHIVE" 2>/dev/null | grep '/vendor/lib64/hw/vulkan\.intel\.so$' >/dev/null; then
    bundle_has_intel=true
fi
if [[ "$amd" == true ]]; then
    pass 'AMD GPU render node found (hardware acceleration available)'
elif [[ "$bundle_has_intel" == true ]]; then
    pass 'Intel GPU render node found and this bundle has Intel drivers (experimental)'
elif [[ "$ALLOW_NON_AMD" == true ]]; then
    info 'WARNING: no supported GPU drivers for this computer; launch games with LEPTON_FORCE_SOFTWARE=true'
elif [[ "$intel" == true ]]; then
    fail 'Intel GPU found, but this bundle has no Intel drivers (AMD only). Install a bundle built with Intel support, or use --allow-non-amd to install anyway'
else
    fail 'No AMD GPU found. This build only ships AMD drivers; use --allow-non-amd to install anyway'
fi

DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/lepton-x86_64"
STEAM_TOOLS="$HOME/.local/share/Steam/compatibilitytools.d"
mkdir -p -- "$DATA_HOME"
DATA_HOME="$(realpath -e -- "$DATA_HOME")"
TEMP="$(mktemp -d "$DATA_HOME/.lepton-install.XXXXXXXX")"

info 'Extracting bundle'
tar -xzf "$ARCHIVE" -C "$TEMP" --no-same-owner
[[ -f "$TEMP/BUNDLE.json" && -x "$TEMP/compat_tool/lepton" ]] || fail 'Archive is not a Lepton x86_64 bundle'

# Read and validate bundle metadata (tool ID, display name, directory).
python3 - "$TEMP/BUNDLE.json" > "$TEMP.meta" <<'PY' || fail 'Invalid BUNDLE.json'
import json, re, sys
m = json.load(open(sys.argv[1], encoding='utf-8'))
tool, name, directory = m['tool_id'], m['display_name'], m['install_directory']
bundle = m.get('bundle_id', '')
if not re.fullmatch(r'[A-Za-z0-9_]{1,96}', tool): raise SystemExit('invalid tool_id')
if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]{0,95}', directory): raise SystemExit('invalid install_directory')
if not name or any(c in name for c in '\x00\r\n'): raise SystemExit('invalid display_name')
print(tool); print(name); print(directory); print(bundle)
# Older bundles have no widevine field: it was never installed in them.
for flag in ('gapps', 'ndk', 'widevine'):
    if not isinstance(m.get(flag, False), bool): raise SystemExit('invalid ' + flag)
    print(str(m.get(flag, False)).lower())
PY
mapfile -t meta < "$TEMP.meta"
rm -f -- "$TEMP.meta"
(( ${#meta[@]} == 7 )) || fail 'Invalid BUNDLE.json'
TOOL_ID="${meta[0]}"; TOOL_NAME="${meta[1]}"; INSTALL_NAME="${meta[2]}"
BUNDLE_ID="${meta[3]}"; HAS_GAPPS="${meta[4]}"; HAS_NDK="${meta[5]}"; HAS_WIDEVINE="${meta[6]}"
MANAGE="$TEMP/compat_tool/tools/lepton-manage-installs"
[[ -f "$MANAGE" ]] || fail 'Bundle lacks lepton-manage-installs'
manage() { python3 "$MANAGE" "$@"; }
# What games need at launch (Podman, Binder, Gamescope, Steam...), checked
# before anything is installed. Older bundles do not have the check.
HOST_CHECK="$TEMP/compat_tool/tools/lepton-host-check"
if [[ -f "$HOST_CHECK" && "${LEPTON_SKIP_HOST_CHECK:-}" != 1 ]]; then
    if [[ "$INSTALL_PROFILE" == local-desktop ]] && ! grep -q -- '--install-profile' "$HOST_CHECK"; then
        fail 'Bundle lacks profile-aware host checks; repackage with updated launcher scripts (no Android rebuild required)'
    fi
    info 'Checking that this computer can run Lepton games'
    bash "$HOST_CHECK" --install-profile "$INSTALL_PROFILE" ||
        fail 'This computer is missing what Lepton needs (see above); nothing was changed. LEPTON_SKIP_HOST_CHECK=1 installs anyway.'
fi
# Started from a desktop icon: offer "new or replace" (tap-only).
INTERACTIVE=false
if [[ "$PAUSE" == true && "$MODE" == execute && -z "${LEPTON_NO_DIALOGS:-}" &&
      ( -n "${WAYLAND_DISPLAY:-}" || -n "${DISPLAY:-}" ) ]] &&
   { command -v zenity >/dev/null 2>&1 || command -v kdialog >/dev/null 2>&1; }; then
    INTERACTIVE=true
fi
if [[ "$INTERACTIVE" == true && -z "$INTO" && "$REPLACE" == false && "$NEW" == false ]]; then
    choice="$(manage --gui-choose-target --new-id "$TOOL_ID" --new-name "$TOOL_NAME")" ||
        fail 'Installation cancelled; nothing was changed'
    [[ "$choice" == new ]] || INTO="$choice"
fi

DEST="$DATA_HOME/$INSTALL_NAME"
[[ "$REPLACE" == false || -n "$INTO" || ! -e "$DEST" ]] || INTO="$TOOL_ID"
BACKUP=''
if [[ -n "$INTO" ]]; then
    DEST="$(manage --print-dir "$INTO")" || fail "No existing install with tool ID $INTO (see lepton-manage-installs --list)"
    DEST="$(realpath -e -- "$DEST")"
    [[ "$DEST" == "$HOME/"* && -d "$DEST" && ! -L "$DEST" ]] || fail "Refusing to overwrite $DEST"
    manage --check-free "$INTO" || fail 'Nothing was changed'
    if [[ "$INTO" != "$TOOL_ID" ]]; then
        info "Overwriting install $INTO (its Steam shortcuts keep working)"
        TOOL_ID="$INTO"
        INSTALL_NAME="$(basename -- "$DEST")"
        # The installed copy identifies itself by the tool ID it now occupies.
        python3 - "$TEMP/BUNDLE.json" "$TOOL_ID" "$INSTALL_NAME" <<'PYINTO' || fail 'Cannot update BUNDLE.json'
import json, sys
path, tool, directory = sys.argv[1:]
data = json.load(open(path, encoding='utf-8'))
data.setdefault('packaged_tool_id', data['tool_id'])
data['tool_id'], data['install_directory'] = tool, directory
open(path, 'w', encoding='utf-8').write(json.dumps(data, indent=2) + '\n')
PYINTO
    fi
    BACKUP="$DEST.previous-$(date +%Y%m%d-%H%M%S)"
elif [[ -e "$DEST" || -L "$DEST" ]]; then
    fail "Already installed at $DEST. Use --replace to overwrite it (or install a bundle with a new ID)."
fi
info "Tool: $TOOL_NAME ($TOOL_ID)"
info "Install directory: $DEST"
for id in "${REMOVE_IDS[@]}"; do
    [[ "$id" != "$TOOL_ID" ]] || fail "--remove $id would remove the install being created"
done
if ((${#REMOVE_IDS[@]})); then
    # Validates names and that none is running; changes nothing.
    manage --remove "${REMOVE_IDS[@]}" | sed 's/^/[INFO] /' || fail 'Nothing was changed'
fi
registration="$STEAM_TOOLS/$TOOL_ID.vdf"
if [[ -f "$registration" ]] && ! grep -Fq "\"$DEST/compat_tool\"" "$registration"; then
    fail "Steam tool ID $TOOL_ID is already registered for another directory: $registration"
fi

# The current host/explicit override wins over both old and archived profiles.
# An unmarked installation remains the standard SteamOS/Gamescope profile.
rm -f -- "$TEMP/compat_tool/install-profile"
if [[ "$INSTALL_PROFILE" == local-desktop ]]; then
    if [[ ! -x "$TEMP/compat_tool/tools/lepton-direct-wayland" ||
          ! -f "$TEMP/compat_tool/tools/lepton-display-common.sh" ]] ||
       ! grep -q 'TOOL/install-profile' "$TEMP/compat_tool/lepton-x86_64-entry"; then
        fail 'Bundle lacks local-desktop launcher support; repackage with updated launcher scripts (no Android rebuild required)'
    fi
    printf '%s\n' local-desktop > "$TEMP/compat_tool/install-profile"
fi

if [[ "$MODE" == check ]]; then
    pass 'Install preflight passed; nothing was changed'
    exit 0
fi

# True if $1 is the pinned Google adb. The hash is checked before running it.
adb_verified() {
    local output
    printf '%s  %s\n' "$ADB_SHA256" "$1" | sha256sum --check --status - || return 1
    output="$(timeout 30 "$1" version 2>&1)" || return 1
    [[ "$output" == *"Version $ADB_VERSION"* ]]
}
# Put the verified adb into the extracted (not yet installed) copy. Any failure
# stops here, before the existing install or Steam registration is touched.
provide_adb() {
    local target="$TEMP/tools/platform-tools/adb" zip origin
    if [[ -f "$target" && ! -L "$target" ]] && adb_verified "$target"; then
        # Older bundles shipped adb themselves; keep it if it is the pinned one.
        pass "ADB $ADB_VERSION from the bundle verified"
        return
    fi
    rm -rf -- "$TEMP/tools/platform-tools"
    ADB_WORK="$(mktemp -d "$DATA_HOME/.lepton-adb.XXXXXXXX")"
    if [[ -n "$ADB_ZIP" ]]; then
        zip="$ADB_ZIP"; origin="local copy of $ADB_URL ($(basename -- "$ADB_ZIP"))"
        info "Using local Google Platform-Tools ZIP: $ADB_ZIP"
    else
        zip="$ADB_WORK/platform-tools.zip"; origin="$ADB_URL"
        info "Downloading ADB $ADB_VERSION from Google (official Android Platform-Tools)"
        info "  $ADB_URL"
        local progress=(--silent --show-error)
        [[ ! -t 2 ]] || progress=(--progress-bar)
        curl --fail --location --proto '=https' --proto-redir '=https' --tlsv1.2 \
            --retry 3 --connect-timeout 20 --max-time 900 "${progress[@]}" \
            --output "$zip" -- "$ADB_URL" ||
            fail 'Could not download ADB from Google. Nothing was installed or changed; check the internet connection and run the installer again.'
    fi
    # Extract only adb and Google's notice; python3 avoids needing unzip.
    python3 - "$zip" "$ADB_WORK" <<'PYZIP' ||
import shutil, sys, zipfile
archive, out = sys.argv[1:]
try:
    with zipfile.ZipFile(archive) as z:
        for name, dest in (('platform-tools/adb', 'adb'), ('platform-tools/NOTICE.txt', 'NOTICE.txt')):
            member = z.getinfo(name)
            if member.is_dir() or member.file_size > 64 * 1024 * 1024:
                raise ValueError('unexpected entry ' + name)
            with z.open(member) as src, open(out + '/' + dest, 'wb') as dst:
                shutil.copyfileobj(src, dst)
except (OSError, KeyError, ValueError, zipfile.BadZipFile) as exc:
    sys.exit('[FAIL] ' + str(exc))
PYZIP
        fail 'The Platform-Tools ZIP does not contain adb and NOTICE.txt. Nothing was installed or changed.'
    chmod 755 "$ADB_WORK/adb"
    printf '%s  %s\n' "$ADB_SHA256" "$ADB_WORK/adb" | sha256sum --check --status - ||
        fail "Downloaded adb does not match the pinned SHA256 $ADB_SHA256. Nothing was installed or changed."
    adb_verified "$ADB_WORK/adb" ||
        fail "Downloaded adb is not version $ADB_VERSION. Nothing was installed or changed."
    install -D -m 755 "$ADB_WORK/adb" "$target"
    install -D -m 644 "$ADB_WORK/NOTICE.txt" "$TEMP/tools/licenses/google-platform-tools-NOTICE.txt"
    cat > "$TEMP/tools/platform-tools/SOURCE.txt" <<SOURCE
Google Android Platform-Tools adb, downloaded by the Lepton installer on this
machine. It is not distributed in the Lepton bundle.
Source: $origin
Version: $ADB_VERSION
adb SHA256 (verified): $ADB_SHA256
Installed: $(date -u +%Y-%m-%dT%H:%M:%SZ)
Upstream notices: tools/licenses/google-platform-tools-NOTICE.txt
SOURCE
    rm -rf -- "$ADB_WORK"
    ADB_WORK=''
    pass "ADB $ADB_VERSION verified (SHA256 and version)"
}
provide_adb

if pgrep -x steam >/dev/null 2>&1; then
    info 'Steam is running: it will only see the new tool after a restart'
fi
if [[ -n "$BACKUP" ]]; then
    mv -T -- "$DEST" "$BACKUP"
fi
mv -T -- "$TEMP" "$DEST"
TEMP=''
pass "Installed to $DEST"

register_args=(--execute)
[[ -z "$INTO" ]] || register_args+=(--replace)
python3 "$DEST/compat_tool/tools/lepton-register-tool" "${register_args[@]}"

mkdir -p -- "$CONFIG_DIR"
env_file="$CONFIG_DIR/$TOOL_ID.env"
{
    printf '# Written by lepton-install-bundle; read by lepton-add-game and run-apk.sh.\n'
    printf 'LEPTON_X86_TOOL_ID=%q\n' "$TOOL_ID"
    printf 'LEPTON_X86_TOOL_NAME=%q\n' "$TOOL_NAME"
    printf 'LEPTON_X86_BUNDLE_ID=%q\n' "$BUNDLE_ID"
    printf 'LEPTON_X86_INSTALL_DIR=%q\n' "$DEST"
    printf 'LEPTON_X86_GAPPS=%q\n' "$HAS_GAPPS"
    printf 'LEPTON_X86_NDK=%q\n' "$HAS_NDK"
    printf 'LEPTON_X86_WIDEVINE=%q\n' "$HAS_WIDEVINE"
    if [[ "$amd" == true ]]; then printf 'LEPTON_X86_RENDERING=amd\n'
    elif [[ "$bundle_has_intel" == true ]]; then printf 'LEPTON_X86_RENDERING=intel\n'
    else printf 'LEPTON_X86_RENDERING=software\n'; fi
    printf 'LEPTON_X86_DISPLAY=desktop\n'
} > "$env_file.tmp"
mv -f -- "$env_file.tmp" "$env_file"
ln -sfn -- "$TOOL_ID.env" "$CONFIG_DIR/default.env"
pass "Settings: $env_file (now the default install)"

bin_dir="$HOME/.local/bin"
mkdir -p -- "$bin_dir"
ln -sfn -- "$DEST/compat_tool/tools/lepton-add-game" "$bin_dir/lepton-add-game"
ln -sfn -- "$DEST/tests/runtime/run-apk.sh" "$bin_dir/lepton-run-apk"
ln -sfn -- "$DEST/compat_tool/tools/lepton-add-game-gui" "$bin_dir/lepton-add-game-gui"
ln -sfn -- "$DEST/compat_tool/tools/lepton-in-terminal" "$bin_dir/lepton-in-terminal"
ln -sfn -- "$DEST/compat_tool/tools/lepton-manage-installs" "$bin_dir/lepton-manage-installs"
pass "Commands: $bin_dir/lepton-add-game, $bin_dir/lepton-add-game-gui, $bin_dir/lepton-run-apk"

# Menu (and desktop) entries: usable without a keyboard. They use the
# ~/.local/bin links, so they always follow the default (latest) install.
apps="$DATA_HOME/applications"
mkdir -p -- "$apps"
if command -v konsole >/dev/null 2>&1; then
    check_exec="konsole -e \"$bin_dir/lepton-in-terminal\" \"$bin_dir/lepton-run-apk\" --gpu-check --execute"; check_terminal=false
else
    check_exec="\"$bin_dir/lepton-in-terminal\" \"$bin_dir/lepton-run-apk\" --gpu-check --execute"; check_terminal=true
fi
cat > "$apps/lepton-x86_64-add-game.desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Name=Lepton: Add Android game
Comment=Add an APK to Steam with the Lepton x86_64 compatibility tool
Exec="$bin_dir/lepton-add-game-gui"
Icon=applications-games
Terminal=false
Categories=Game;
DESKTOP
cat > "$apps/lepton-x86_64-gpu-check.desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Name=Lepton: Check graphics
Comment=Boot Android once and confirm AMD hardware acceleration
Exec=$check_exec
Icon=video-display
Terminal=$check_terminal
Categories=Game;
DESKTOP
cat > "$apps/lepton-x86_64-manage-installs.desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Name=Lepton: Remove installs
Comment=Remove old Lepton x86_64 installs and backups
Exec="$bin_dir/lepton-manage-installs" --gui
Icon=edit-delete
Terminal=false
Categories=Game;
DESKTOP
desktop_dir="$HOME/Desktop"
if [[ -d "$desktop_dir" ]]; then
    for entry in lepton-x86_64-add-game.desktop lepton-x86_64-gpu-check.desktop lepton-x86_64-manage-installs.desktop; do
        install -m 755 "$apps/$entry" "$desktop_dir/$entry"
    done
fi
pass "Menu entries: Lepton: Add Android game, Lepton: Check graphics, Lepton: Remove installs"

# Lepton: Install / Update / Repair lives outside every versioned install, so it
# keeps working when all of them are removed. An older bundle never replaces a
# newer copy; files are replaced by rename, so a running copy is unaffected.
manager_src="$DEST/compat_tool/tools/lepton-release-manager"
if [[ -f "$manager_src" ]]; then
    manager_home="$DATA_HOME/lepton-release-manager"
    new_version="$(python3 "$manager_src" --version)"
    old_version=0
    if [[ -f "$manager_home/lepton-release-manager" ]]; then
        old_version="$(python3 "$manager_home/lepton-release-manager" --version 2>/dev/null)" || old_version=0
        [[ "$old_version" =~ ^[0-9]+$ ]] || old_version=0
    fi
    if [[ "$new_version" =~ ^[0-9]+$ ]] && (( new_version >= old_version )); then
        mkdir -p -- "$manager_home"
        for file in lepton-release-manager lepton-manage-installs; do
            install -m 755 "$DEST/compat_tool/tools/$file" "$manager_home/.$file.new"
            mv -f -- "$manager_home/.$file.new" "$manager_home/$file"
        done
        install -m 644 "$DEST/compat_tool/release-keys/allowed_signers" "$manager_home/.allowed_signers.new"
        mv -f -- "$manager_home/.allowed_signers.new" "$manager_home/allowed_signers"
        ln -sfn -- "$manager_home/lepton-release-manager" "$bin_dir/lepton-release-manager"
        cat > "$apps/lepton-release-manager.desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Name=Lepton: Install / Update / Repair
Comment=Install, update or repair Lepton x86_64 from its GitHub releases
Exec="$manager_home/lepton-release-manager"
Icon=system-software-update
Terminal=false
Categories=Game;
DESKTOP
        [[ ! -d "$desktop_dir" ]] || install -m 755 "$apps/lepton-release-manager.desktop" "$desktop_dir/lepton-release-manager.desktop"
        pass "Lepton: Install / Update / Repair (version $new_version) in $manager_home"
    else
        info "Kept the newer Lepton: Install / Update / Repair (version $old_version) in $manager_home"
    fi
fi
if [[ "$HAS_GAPPS" == true ]]; then
    # Google games use saved profiles inside THIS install, so these icons point
    # at its own copy (not the ~/.local/bin default links).
    google_gui="$DEST/compat_tool/tools/lepton-google-game-gui"
    for kind in add sign-in; do
        entry="lepton-x86_64-google-$kind-$TOOL_ID.desktop"
        if [[ "$kind" == add ]]; then
            label="Lepton: Add Google game ($BUNDLE_ID)"; args=''; icon=list-add
        else
            label="Lepton: Google sign-in ($BUNDLE_ID)"; args=' --sign-in'; icon=system-users
        fi
        cat > "$apps/$entry" <<DESKTOP
[Desktop Entry]
Type=Application
Name=$label
Comment=Google sign-in and Steam shortcuts for games that need Google services
Exec="$google_gui"$args
Icon=$icon
Terminal=false
Categories=Game;
DESKTOP
        [[ ! -d "$desktop_dir" ]] || install -m 755 "$apps/$entry" "$desktop_dir/$entry"
    done
    pass "Google game icons: Lepton: Add Google game, Lepton: Google sign-in ($BUNDLE_ID)"
fi

installed_manage="$DEST/compat_tool/tools/lepton-manage-installs"
if [[ -n "$BACKUP" ]]; then
    # Carry saved app profiles (Google sign-in + game data) into the new copy.
    # Same Android image: they work at once; a changed image makes run-apk ask
    # for --accept-runtime-update before reusing them.
    moved=0
    for profile in "$BACKUP"/.runtime-profile.*; do
        [[ -d "$profile" && ! -e "$DEST/${profile##*/}" ]] || continue
        mv -T -- "$profile" "$DEST/${profile##*/}" && moved=$((moved + 1))
    done
    ((moved == 0)) || pass "Moved $moved saved app profile(s) into the new install"
    if [[ "$KEEP_PREVIOUS" == true ]]; then
        info "Previous copy kept at $BACKUP"
    elif compgen -G "$BACKUP/.runtime-profile.*" > /dev/null; then
        # Saved app profiles (e.g. Google sign-in) live inside the install.
        KEEP_PREVIOUS=true
        info "Previous copy kept at $BACKUP: it contains saved app profiles (e.g. Google sign-in)."
        info 'Remove it with "Lepton: Remove installs" once they are no longer needed.'
    elif python3 "$installed_manage" --remove "$(basename -- "$BACKUP")" --execute >/dev/null; then
        pass 'Previous copy removed'
    else
        info "Could not remove the previous copy at $BACKUP; use \"Lepton: Remove installs\""
    fi
fi
if ((${#REMOVE_IDS[@]})); then
    python3 "$installed_manage" --remove "${REMOVE_IDS[@]}" --execute | sed 's/^/[PASS] /' ||
        info 'Some installs were not removed; see above'
elif [[ "$INTERACTIVE" == true ]]; then
    python3 "$installed_manage" --gui --quiet-if-empty --exclude "$TOOL_ID" \
        --prompt "Installed $TOOL_NAME. Optionally remove older Lepton installs:" || true
fi
expected_driver='SwiftShader: software rendering'
[[ "$amd" != true ]] || expected_driver=RADV
[[ "$amd" == true || "$bundle_has_intel" != true ]] || expected_driver='Intel (ANV)'

cat <<EOF

Next steps (desktop icons or application menu > Games; no typing needed)
  1. "Lepton: Check graphics" (about a minute; should report $expected_driver)
  2. "Lepton: Add Android game": pick an APK; exit Steam when asked,
     then start Steam again once it reports success
  3. In the game's controller layout enable Touchscreen Native Support
  4. "Lepton: Install / Update / Repair": later versions, updates and repair
Terminal equivalents: lepton-run-apk --gpu-check --execute,
                      lepton-add-game GAME.apk (with Steam exited; in ~/.local/bin)
EOF
if [[ -n "$BACKUP" && "$KEEP_PREVIOUS" == true ]]; then
    printf '\nPrevious install kept at %s (remove it with "Lepton: Remove installs").\n' "$BACKUP"
fi
