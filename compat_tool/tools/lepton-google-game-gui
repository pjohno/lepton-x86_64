#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Tap-only setup of games that need Google sign-in (GApps installs), using a
# saved profile per game (Google identity + game data; one game per profile):
#
#   lepton-google-game-gui            pick game -> sign in -> install/check -> Steam shortcut
#   lepton-google-game-gui --sign-in  sign in again for an existing profile
#
# Android runs in a desktop window via this install's run-apk.sh; "Done"
# buttons stop it cleanly. This tool NEVER closes or starts Steam: it asks
# the user to exit Steam before adding the shortcut.
set -Euo pipefail

TOOLS="$(dirname -- "$(realpath -e -- "${BASH_SOURCE[0]}")")"
ROOT="$(dirname -- "$(dirname -- "$TOOLS")")"
RUNNER="$ROOT/tests/runtime/run-apk.sh"
ADD_GAME="$TOOLS/lepton-add-game"
TITLE='Lepton: Google game'
MODE=add
[[ "${1:-}" != --sign-in ]] || MODE=sign-in

if [[ -n "${LEPTON_DIALOG:-}" ]]; then
    UI="$LEPTON_DIALOG"
elif command -v zenity >/dev/null 2>&1; then
    UI=zenity
elif command -v kdialog >/dev/null 2>&1; then
    UI=kdialog
else
    printf 'Neither zenity nor kdialog is available.\n' >&2
    exit 1
fi

show() {  # show info|error TEXT
    if [[ "$UI" == zenity ]]; then
        zenity "--$1" --title="$TITLE" --no-markup --width=520 --text="$2" 2>/dev/null
    elif [[ "$1" == error ]]; then
        kdialog --title "$TITLE" --error "$2"
    else
        kdialog --title "$TITLE" --msgbox "$2"
    fi
    return 0
}
ask() {  # ask TEXT OK_LABEL CANCEL_LABEL
    if [[ "$UI" == zenity ]]; then
        zenity --question --title="$TITLE" --no-markup --width=520 --text="$1" \
            --ok-label="$2" --cancel-label="$3" 2>/dev/null
    else
        kdialog --title "$TITLE" --yes-label "$2" --no-label "$3" --yesno "$1"
    fi
}
fail_box() { show error "$1"; exit 1; }

[[ -f "$ROOT/BUNDLE.json" && -f "$RUNNER" && -f "$ADD_GAME" ]] ||
    { show error "This Lepton install is incomplete ($ROOT)."; exit 1; }
[[ -f "$ROOT/compat_tool/images/rootfs/system/product/priv-app/PrebuiltGmsCore/PrebuiltGmsCore.apk" ]] ||
    fail_box 'This Lepton install has no Google services. Install a GApps bundle first.'

LOG_DIR="$(mktemp -d)"
trap 'rm -rf -- "$LOG_DIR"' EXIT

# run_android TEXT_WAITING READY_PATTERN TEXT_READY -- RUNNER ARGS...
# Runs Android in the background with a live dialog whose button ("Done")
# stops it. Returns 0 if the user tapped Done, 1 if Android ended by itself.
run_android() {
    local waiting="$1" ready="$2" ready_text="$3"
    shift 4
    local log="$LOG_DIR/run.log"
    : > "$log"
    "$@" > "$log" 2>&1 &
    local pid=$!
    local user_done=1
    if [[ "$UI" == zenity ]]; then
        local rc=0
        # Process substitution: wait only for the dialog; the feeder ends once
        # Android has been stopped (a pipeline would wait for it).
        zenity --progress --pulsate --auto-close --title="$TITLE" --width=560 \
            --text="$waiting" --cancel-label=Done 2>/dev/null < <(
            printf '# %s\n' "$waiting"
            local said='' gsf=''
            while kill -0 "$pid" 2>/dev/null; do
                if [[ -z "$said" ]] && grep -q -- "$ready" "$log"; then
                    printf '# %s\n' "$ready_text"; said=1
                fi
                if [[ -z "$gsf" ]] && gsf="$(sed -n 's/.*GSF Android ID: \([0-9]\{1,\}\).*/\1/p' "$log" | head -n 1)" && [[ -n "$gsf" ]]; then
                    printf '# %s  If Google says this device is not certified, register ID %s at google.com/android/uncertified\n' \
                        "$ready_text" "$gsf"
                fi
                sleep 1
            done
            echo 100
        ) || rc=$?
        [[ "$rc" == 0 ]] || user_done=0
    else
        kdialog --title "$TITLE" --msgbox "$ready_text"$'\n\nPress OK when finished.'
        user_done=0
        if gsf="$(sed -n 's/.*GSF Android ID: \([0-9]\{1,\}\).*/\1/p' "$log" | head -n 1)" && [[ -n "$gsf" ]]; then
            show info "Google device registration ID: $gsf (google.com/android/uncertified)"
        fi
    fi
    if kill -0 "$pid" 2>/dev/null; then
        kill -TERM "$pid" 2>/dev/null || true   # run-apk cleans up on TERM
        local i
        for ((i = 0; i < 120; i++)); do kill -0 "$pid" 2>/dev/null || break; sleep 1; done
    fi
    wait "$pid" 2>/dev/null || true
    return "$user_done"
}

profile_dirs() { compgen -G "$ROOT/.runtime-profile.*" || true; }

sign_in() {  # sign_in PROFILE
    if run_android 'Starting Android for Google sign-in...' 'Setup profile ready' \
        'Sign in to Google in the Android window (Play Store), then tap Done.' -- \
        "$RUNNER" --profile "$1" --setup-only --network-sysctls --seconds 3600 --execute; then
        return 0
    fi
    fail_box "Android stopped unexpectedly during sign-in:

$(tail -n 15 "$LOG_DIR/run.log")"
}

if [[ "$MODE" == sign-in ]]; then
    mapfile -t dirs < <(profile_dirs)
    ((${#dirs[@]})) || fail_box 'No Google game profiles yet. Use "Lepton: Add Google game" first.'
    rows=()
    for dir in "${dirs[@]}"; do
        name="${dir##*/.runtime-profile.}"
        game="$(cat "$dir/profile-package" 2>/dev/null || echo 'no game installed yet')"
        rows+=("$name" "$game")
    done
    if [[ "$UI" == zenity ]]; then
        args=()
        for ((i = 0; i < ${#rows[@]}; i += 2)); do args+=(FALSE "${rows[i]}" "${rows[i+1]}"); done
        profile="$(zenity --list --radiolist --title="$TITLE" --text='Sign in again for which game profile?' \
            --column= --column=Profile --column=Game --width=560 --height=360 "${args[@]}" 2>/dev/null)" || exit 0
    else
        args=()
        for ((i = 0; i < ${#rows[@]}; i += 2)); do args+=("${rows[i]}" "${rows[i]} (${rows[i+1]})" off); done
        profile="$(kdialog --title "$TITLE" --radiolist 'Sign in again for which game profile?' "${args[@]}")" || exit 0
    fi
    [[ -n "$profile" ]] || exit 0
    sign_in "$profile"
    show info 'Sign-in finished. The profile keeps your Google account.'
    exit 0
fi

# ---- Add a Google game ----
if [[ "$UI" == zenity ]]; then
    game="$(zenity --file-selection --title="$TITLE: choose the game" --filename="$HOME/Downloads/" \
        --file-filter='Android apps (*.apk *.apkm) | *.apk *.APK *.apkm *.APKM' 2>/dev/null)" || exit 0
else
    game="$(kdialog --title "$TITLE" --getopenfilename "$HOME/Downloads" '*.apk *.APK *.apkm *.APKM|Android apps')" || exit 0
fi
[[ -n "$game" && -f "$game" ]] || exit 0
default_name="$(basename -- "$game")"
default_name="${default_name%.*}"
if [[ "$UI" == zenity ]]; then
    name="$(zenity --entry --title="$TITLE" --text='Name shown in Steam:' --entry-text="$default_name" 2>/dev/null)" || exit 0
else
    name="$(kdialog --title "$TITLE" --inputbox 'Name shown in Steam:' "$default_name")" || exit 0
fi
[[ -n "$name" ]] || name="$default_name"

# One profile per game, named after it.
profile="$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-*//; s/-*$//' | cut -c1-48)"
[[ -n "$profile" ]] || profile=game
# Prefer native x86_64 libraries; ARM64-only games need an NDK install.
abi="$(python3 - "$game" <<'PY'
import sys, zipfile
names = zipfile.ZipFile(sys.argv[1]).namelist()
joined = "\n".join(names)
if "lib/x86_64/" in joined or "x86_64" in joined:
    print("x86_64")
elif "lib/arm64-v8a/" in joined or "arm64_v8a" in joined:
    print("arm64-v8a")
else:
    print("x86_64")
PY
)" || fail_box 'This file is not a readable APK or APKM.'

if [[ -d "$ROOT/.runtime-profile.$profile" ]]; then
    if ask "A profile named \"$profile\" already exists.

Sign in to Google again, or skip straight to installing the game?" 'Sign in again' 'Skip sign-in'; then
        sign_in "$profile"
    fi
else
    ask "Step 1 of 3: Google sign-in for \"$name\".

Android opens in a window with the Play Store. Sign in to Google there, then tap Done in the Lepton dialog.
This profile keeps the sign-in and the game's data." 'Start' 'Cancel' || exit 0
    sign_in "$profile"
fi

ask "Step 2 of 3: install and check \"$name\".

The game is installed into its profile and opens. Check that it works, then tap Done." 'Start' 'Cancel' || exit 0
run_android "Installing $name..." 'Launching ' "$name is open. Check it works, then tap Done." -- \
    "$RUNNER" --profile "$profile" --app --expect-abi "$abi" --apk "$game" \
    --network-sysctls --until-exit --execute || true
grep -Eq '^\[INFO\] Launching |Reusing installed APK set' "$LOG_DIR/run.log" ||
    fail_box "The game could not be installed or started:

$(tail -n 15 "$LOG_DIR/run.log")"

# Validate before asking the user to close Steam (a dry run reads only).
check="$(python3 "$ADD_GAME" "$game" --runtime-profile "$profile" --expect-abi "$abi" --name "$name" --dry-run 2>&1)" ||
    fail_box "Cannot add this game to Steam:

$check"
ask "Step 3 of 3: add \"$name\" to Steam.

Now exit Steam yourself:
  - Steam window: Steam menu (top left) > Exit, or
  - taskbar: right-click the Steam icon > Exit.
Wait until the Steam window and its taskbar icon have gone, then tap \"Steam is closed\".
This tool never closes or starts Steam." 'Steam is closed' 'Cancel' || exit 0
if out="$(python3 "$ADD_GAME" "$game" --runtime-profile "$profile" --expect-abi "$abi" --name "$name" 2>&1)"; then
    show info "\"$name\" was added to Steam (Non-Steam games). It is now safe to start Steam again.

In the shortcut's Properties, leave \"Force the use of a specific Steam Play compatibility tool\" unchecked, and enable Touchscreen Native Support in its controller layout.

$out"
else
    fail_box "Adding the game to Steam failed:

$out

Steam's shortcuts were not changed. You can start Steam again."
fi
