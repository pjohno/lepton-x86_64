#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -euo pipefail
# Tells lepton-x86_64-entry (inside the nested Gamescope) not to add another bridge.
export LEPTON_BRIDGE_ACTIVE=1

# Error popup for the player: TITLE MESSAGE [TIMEOUT]. Gaming Mode only shows
# windows tagged with the running game's AppID, so there it is a scaled Qt
# dialog on Steam's X11 display, tagged STEAM_GAME; on the desktop a regular
# Wayland dialog.
lepton_dialog() {
    local title="$1" message="$2" limit="${3:-60s}"

    # Desktop Wayland has no outer X11 window to tag; show a regular dialog.
    if [[ "$display_mode" == desktop ]]; then
        if command -v kdialog >/dev/null 2>&1; then
            QT_QPA_PLATFORM=wayland timeout "$limit" kdialog \
                --title "$title" --error "$message" || true
        fi
        return 0
    fi

    # Show a scaled Qt dialog through X11, tagged for Steam Gamescope.
    local win="" dialog_pid

    DISPLAY="$outer_display" QT_QPA_PLATFORM=xcb QT_SCALE_FACTOR=2 \
        timeout "$limit" kdialog \
        --title "$title" --error "$message" &
    dialog_pid=$!

    for ((i=0; i<80; i++)); do
        kill -0 "$dialog_pid" 2>/dev/null || break

        win=$(DISPLAY="$outer_display" xwininfo -root -tree 2>/dev/null |
            awk -v title="$title" \
                'index($0, "\"" title "\"") {print $1; exit}')

        [[ -n "$win" ]] && break
        sleep 0.1
    done

    if [[ -n "$win" ]]; then
        DISPLAY="$outer_display" xprop -id "$win" \
            -f STEAM_GAME 32c -set STEAM_GAME "$app_id"
        echo "Assigned Steam AppID $app_id to dialog window $win"
    else
        echo "WARNING: Could not identify the kdialog window" >&2
        kill "$dialog_pid" 2>/dev/null || true
    fi

    wait "$dialog_pid" 2>/dev/null || true
}

# Lepton BinderFS preflight. Never load or install kernel modules.
lepton_check_binder() {
    grep -qw binder /proc/filesystems 2>/dev/null && return 0

    local message
    message="Android Binder kernel support is unavailable.

Lepton requires BinderFS, provided by rust_binder, binder_linux,
or another compatible kernel implementation.

Please initialize Binder support and launch the game again.

Lepton will not install or load kernel modules."

    printf 'ERROR: %s\n' "$message" >&2
    lepton_dialog "Lepton Binder Unavailable" "$message"
    return 1
}

# Lepton writes why a game could not start (for example a refused profile) to
# LEPTON_MESSAGE_FILE; show it once Lepton and the nested Gamescope have exited.
message_file=""
show_launch_message() {
    [[ -n "$message_file" && -s "$message_file" ]] || return 0
    lepton_dialog "Lepton: game could not start" "$(cat "$message_file")
Details: ~/.steam/steam/logs/lepton-steamlaunch-$app_id.log" 180s
}
cleanup_message_file() { [[ -z "$message_file" ]] || rm -f -- "$message_file"; }

app_id="${SteamAppId:-}"
if [[ ! "$app_id" =~ ^[1-9][0-9]*$ && "${SteamGameId:-}" =~ ^[0-9]+$ ]]; then
    printf -v game_id_hex '%016x' "$SteamGameId"
    app_id="$((16#${game_id_hex:0:8}))"
fi
[[ "$app_id" =~ ^[1-9][0-9]*$ ]] || {
    echo "ERROR: A real SteamAppId is required" >&2
    exit 1
}

export SteamAppId="$app_id"

# Gaming Mode must keep its tested SDL/X11 fullscreen path. A KDE Plasma
# Wayland desktop can instead use Gamescope's native Wayland window backend.
# Wayland variables alone are not sufficient: Gaming Mode is also Wayland.
# SteamOS's Gaming Mode session exports GAMESCOPE_WAYLAND_DISPLAY. Without that
# or a KDE session, prefer a desktop window: a fullscreen Gaming Mode window on
# a desktop has no way out on a Steam Deck.
display_mode="${LEPTON_DISPLAY_MODE:-auto}"
case "$display_mode" in
    auto)
        session_hint="${XDG_CURRENT_DESKTOP:-} ${XDG_SESSION_DESKTOP:-} ${DESKTOP_SESSION:-}"
        session_hint="${session_hint,,}"
        if [[ "${XDG_SESSION_TYPE:-}" == wayland &&
              " $session_hint " =~ (kde|plasma) ]]; then
            display_mode=desktop
        elif [[ -n "${GAMESCOPE_WAYLAND_DISPLAY:-}" ]]; then
            display_mode=gaming
        elif [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
            echo "WARNING: display mode uncertain (no KDE or Gamescope session found); using a desktop window. Set LEPTON_DISPLAY_MODE=gaming to override." >&2
            display_mode=desktop
        else
            echo "WARNING: display mode uncertain and no Wayland display; using the Gaming Mode (X11) path. Set LEPTON_DISPLAY_MODE to override." >&2
            display_mode=gaming
        fi
        ;;
    desktop|gaming) ;;
    *)
        echo "ERROR: LEPTON_DISPLAY_MODE must be auto, desktop or gaming" >&2
        exit 2
        ;;
esac
outer_display="${DISPLAY:-}"
if [[ "$display_mode" == desktop ]]; then
    [[ -n "${WAYLAND_DISPLAY:-}" && -n "${XDG_RUNTIME_DIR:-}" ]] || {
        echo "ERROR: Desktop Wayland requires WAYLAND_DISPLAY and XDG_RUNTIME_DIR" >&2
        exit 1
    }
else
    [[ -n "$outer_display" ]] || {
        echo "ERROR: Gaming Mode needs an X11 DISPLAY for Steam window tagging" >&2
        exit 1
    }
fi

# Experimental, opt-in (LEPTON_DESKTOP_DIRECT=1): no Gamescope; Android draws
# straight into a KDE window. Known problems with fractional desktop scaling:
# Android gets the wrong size, pointer positions miss and the window does not
# redraw reliably. Kept for later work on desktop support.
if [[ "$display_mode" == desktop && "${LEPTON_DESKTOP_DIRECT:-0}" == 1 ]]; then
    echo "Lepton display: desktop Wayland ($WAYLAND_DISPLAY), no Gamescope (experimental)"
    lepton_check_binder || exit 1
    export GAMESCOPE_WAYLAND_DISPLAY="$WAYLAND_DISPLAY"
    exec "$@"
fi

# Android's screen size is fixed when it starts, so pick it now.
# Desktop: a movable KDE window at 80% of the usable desktop, 16:10 (1024x640
# on a Steam Deck, also the fallback), so the title bar and panel stay
# reachable. LEPTON_DESKTOP_FULLSCREEN=1 fills the main screen instead.
# LEPTON_RESOLUTION=WxH sets Android's size in either case (the window's size
# when windowed). LEPTON_DESKTOP_WINDOWED=1 is the default and still accepted.
# Gaming Mode: unchanged; the screen's size, or LEPTON_RESOLUTION, fullscreen.
#
# Prints the main screen as "physical_w physical_h logical_w logical_h", with
# rotation applied (the Deck's panel is 800x1280, rotated) and scale for logical.
desktop_screen_size() {
    command -v kscreen-doctor >/dev/null 2>&1 || return 1
    kscreen-doctor -j 2>/dev/null | python3 -c '
import json, sys
outputs = [o for o in json.load(sys.stdin).get("outputs", []) if o.get("enabled")]
outputs.sort(key=lambda o: o.get("priority") or 99)  # 1 = main screen
for o in outputs:
    mode = {m["id"]: m for m in o.get("modes", [])}.get(o.get("currentModeId"))
    if mode:
        w, h = mode["size"]["width"], mode["size"]["height"]
        if o.get("rotation") in (2, 8):  # left / right: portrait panel
            w, h = h, w
        scale = float(o.get("scale") or 1) or 1
        print(w, h, int(w / scale), int(h / scale))
        break
' 2>/dev/null
}
resolution="${LEPTON_RESOLUTION:-}"
if [[ "$display_mode" == desktop && -n "$resolution" && ! "$resolution" =~ ^[1-9][0-9]*x[1-9][0-9]*$ ]]; then
    echo "WARNING: Invalid LEPTON_RESOLUTION: $resolution (expected WIDTHxHEIGHT); using the default" >&2
    resolution=""
fi
desktop_fullscreen=()
if [[ "$display_mode" == desktop ]]; then
    if [[ "${LEPTON_DESKTOP_FULLSCREEN:-0}" == 1 && "${LEPTON_DESKTOP_WINDOWED:-0}" == 1 ]]; then
        echo "WARNING: LEPTON_DESKTOP_FULLSCREEN=1 and LEPTON_DESKTOP_WINDOWED=1 both set; using a window" >&2
    elif [[ "${LEPTON_DESKTOP_FULLSCREEN:-0}" == 1 ]]; then
        desktop_fullscreen=(-f)
    fi
    if [[ -z "$resolution" ]]; then
        resolution=1024x640
        if read -r phys_w phys_h logical_w logical_h < <(desktop_screen_size) &&
           [[ "$phys_w $phys_h $logical_w $logical_h" =~ ^[1-9][0-9]*\ [1-9][0-9]*\ [1-9][0-9]*\ [1-9][0-9]*$ ]]; then
            if (( ${#desktop_fullscreen[@]} )); then
                resolution="${phys_w}x${phys_h}"
            else
                # 80% of the desktop, 16:10, even sizes.
                width=$(( logical_w * 8 / 10 ))
                height=$(( width * 10 / 16 ))
                if (( height > logical_h * 8 / 10 )); then
                    height=$(( logical_h * 8 / 10 ))
                    width=$(( height * 16 / 10 ))
                fi
                (( width >= 320 && height >= 200 )) &&
                    resolution="$(( width / 2 * 2 ))x$(( height / 2 * 2 ))"
            fi
        fi
    fi
fi
if [[ -z "$resolution" ]]; then
    resolution="$(DISPLAY="$outer_display" xdpyinfo 2>/dev/null |
        awk '/dimensions:/ {print $2; exit}')"
fi

if [[ ! "$resolution" =~ ^[1-9][0-9]*x[1-9][0-9]*$ ]]; then
    echo "WARNING: Invalid or unavailable resolution: $resolution" >&2
    resolution="1280x800"
fi

width="${resolution%x*}"
height="${resolution#*x}"

window=fullscreen
[[ "$display_mode" != desktop || ${#desktop_fullscreen[@]} -gt 0 ]] || window=windowed
echo "Lepton Gamescope mode: $display_mode; resolution: ${width}x${height}; $window"

lepton_check_binder || exit 1

message_file="$(mktemp "${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/lepton-message.XXXXXX" 2>/dev/null)" || message_file=""
[[ -z "$message_file" ]] || export LEPTON_MESSAGE_FILE="$message_file"
trap cleanup_message_file EXIT

if [[ "$display_mode" == desktop ]]; then
    # A movable KDE window (fullscreen only on request), no X11 Steam window
    # tagging. Never --borderless: Plasma's title bar is the way out.
    # The inner gamescope sets WAYLAND_DISPLAY for the Lepton container.
    ENABLE_GAMESCOPE_WSI=0 gamescope --backend wayland --expose-wayland "${desktop_fullscreen[@]}" \
        -W "$width" -H "$height" -w "$width" -h "$height" \
        --default-touch-mode 4 \
        -- sh -c 'export GAMESCOPE_WAYLAND_DISPLAY="$WAYLAND_DISPLAY"; exec "$@"' sh "$@" || status=$?
    show_launch_message
    exit "${status:-0}"
fi

# Preserve the previously tested Gaming Mode path unchanged.
SDL_VIDEODRIVER=x11 ENABLE_GAMESCOPE_WSI=0 \
gamescope --backend sdl --expose-wayland -f \
    -W "$width" -H "$height" -w "$width" -h "$height" \
    --default-touch-mode 4 \
    -- sh -c 'export GAMESCOPE_WAYLAND_DISPLAY="$WAYLAND_DISPLAY"; exec "$@"' sh "$@" &
child=$!

trap 'kill -TERM "$child" 2>/dev/null || true' INT TERM

tagged=0
for ((i=0; i<120; i++)); do
    kill -0 "$child" 2>/dev/null || break

    while read -r win; do
        [[ -n "$win" ]] || continue

        owner=$(DISPLAY="$outer_display" xprop -id "$win" _NET_WM_PID 2>/dev/null |
            awk -F '= ' 'NF > 1 {print $2}')

        if [[ "$owner" == "$child" ]]; then
            DISPLAY="$outer_display" xprop -id "$win" \
                -f STEAM_GAME 32c -set STEAM_GAME "$app_id"
            echo "Assigned Steam AppID $app_id to window $win"
            tagged=1
            break
        fi
    done < <(
        DISPLAY="$outer_display" xwininfo -root -tree 2>/dev/null |
            awk '/"gamescope":/ {print $1}'
    )

    (( tagged )) && break
    sleep 0.25
done

(( tagged )) || echo "WARNING: Gamescope window was not identified" >&2
wait "$child" || status=$?
show_launch_message
exit "${status:-0}"
