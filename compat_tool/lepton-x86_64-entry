#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Steam entry point for x86_64 Lepton bundles (toolmanifest "commandline").
#
# Makes each installed tool self-contained, so game shortcuts need no launch
# options and switching a game's compatibility tool switches everything:
#   - LEPTON_ADB and PATH point at this install's tools/ (unless already set);
#   - APP_WANTS_FLATSCREEN defaults to true (flatscreen-only port);
#   - game launches (waitforexitandrun) run inside this install's
#     direct Wayland for a local-desktop profile, otherwise Gamescope, unless
#     already inside a display launcher (e.g. an older
#     shortcut whose launch options still start one).
# Every other verb goes straight to Valve's unchanged ./lepton script.
set -euo pipefail

TOOL="$(cd -- "$(dirname -- "$(realpath -e -- "${BASH_SOURCE[0]}")")" && pwd -P)"
ROOT="$(dirname -- "$TOOL")"

if [[ -z "${LEPTON_ADB:-}" && -x "$ROOT/tools/platform-tools/adb" ]]; then
    export LEPTON_ADB="$ROOT/tools/platform-tools/adb"
fi
if [[ -d "$ROOT/tools/bin" ]]; then
    export PATH="$ROOT/tools/bin:$PATH"
fi
export APP_WANTS_FLATSCREEN="${APP_WANTS_FLATSCREEN:-true}"

# True if this process already runs inside a lepton-gamescope-bridge.
inside_bridge() {
    [[ "${LEPTON_BRIDGE_ACTIVE:-}" == 1 ]] && return 0
    local pid=$PPID depth=0 cmdline stat
    while (( pid > 1 && depth < 32 )); do
        cmdline="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)"
        [[ "$cmdline" == *lepton-gamescope-bridge* ]] && return 0
        stat="$(cat "/proc/$pid/stat" 2>/dev/null || true)"
        [[ -n "$stat" ]] || break
        stat="${stat##*) }"          # drop "pid (comm) " (comm may contain spaces)
        read -r _ pid _ <<< "$stat"  # state, ppid, ...
        depth=$((depth + 1))
    done
    return 1
}

# Games added with "Add Google game" need Google services: refuse a tool
# without them before Android starts, with a message the player can see.
if [[ "${1:-}" == waitforexitandrun && -f "${STEAM_COMPAT_DATA_PATH:-/nonexistent}/lepton-google-game" &&
      ! -f "$TOOL/images/rootfs/system/product/priv-app/PrebuiltGmsCore/PrebuiltGmsCore.apk" ]]; then
    message="This game needs Google services, but this Lepton tool has none.
Select a Lepton GApps tool in the game's Properties > Compatibility."
    printf 'ERROR: %s\n' "$message" >&2
    if command -v zenity >/dev/null 2>&1 && [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
        timeout 120 zenity --error --title='Lepton' --no-markup --width=480 --text="$message" 2>/dev/null || true
    fi
    exit 1
fi

if [[ "${1:-}" == waitforexitandrun && "${LEPTON_NO_BRIDGE:-false}" != true ]] && ! inside_bridge; then
    # Read data, never shell code. Unmarked/older tools keep the Deck path.
    profile=""
    [[ ! -f "$TOOL/install-profile" ]] || profile="$(cat "$TOOL/install-profile")"
    # A copied local installation must not change SteamOS's default routing.
    steamos=false
    if [[ -r /etc/os-release ]] && grep -Eq '^ID=("steamos"|steamos)$' /etc/os-release; then
        steamos=true
    fi
    if [[ "$profile" == local-desktop && "$steamos" == false ]]; then
        if [[ "${LEPTON_LOCAL_USE_GAMESCOPE:-0}" == 1 ]]; then
            # The local fallback is always a safe desktop window by default.
            export LEPTON_DISPLAY_MODE=desktop LEPTON_DESKTOP_DIRECT=0
        else
            exec "$TOOL/tools/lepton-direct-wayland" "$TOOL/lepton" "$@"
        fi
    fi
    exec "$TOOL/tools/lepton-gamescope-bridge" "$TOOL/lepton" "$@"
fi
exec "$TOOL/lepton" "$@"
