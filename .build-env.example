# Lepton Android 14 x86_64 build configuration

# Default location for a fresh Android source/build tree.
# Change this if preflight reports insufficient disk space.
LEPTON_OUTPUT_DIR="${HOME}/lepton-build"

LEPTON_BUILD_TARGET="aosp_lepton_x86_64-ap2a-userdebug"
# Select one builder for both source preparation and image compilation.
# Standalone scripts retain legacy defaults when this is unset; the full x86_64
# wrapper selects Ubuntu 26.04 and passes that choice to all child scripts.
LEPTON_BUILD_CONTAINER="lepton-builder-ubuntu26:latest"
LEPTON_BUILD_JOBS=6
LEPTON_MIN_FREE_GIB=200
LEPTON_LOG_DIR="${HOME}/lepton-build-logs/clean14"

# Finished Steam Deck bundles (local paths; never commit .build-env).
LEPTON_DECK_BUNDLE_DIR="${HOME}/lepton-deck-bundles"
# Optional: LEPTON_DECK_BUNDLE_ID="dev-test"

# Optional Google inputs for --with-gapps and --with-ndk. Make both from the
# Google Play API 34 x86_64 emulator image zip you downloaded yourself:
#   bash image-14/scripts/prepare-google-inputs.sh --zip x86_64-34_r14.zip --output DIR
# LEPTON_GOOGLE_IMAGES="DIR/logical-partitions"
# LEPTON_NDK_PAYLOAD="DIR/ndk-translation/payload"
