index 0000000000000000000000000000000000000000..6aa8adebee82c407ce66548a99b0021c63e1bb3b
--- /dev/null
+++ b/image-14/scripts/package-repro-rootfs.sh
@@ -0,0 +1,87 @@
+#!/usr/bin/env bash
+set -Eeuo pipefail
+
+if [[ $# -ne 1 ]]; then
+    echo "Usage: $0 /path/to/aosp-checkout" >&2
+    exit 2
+fi
+
+aosp="$(readlink -f "$1")"
+product="$aosp/out/target/product/lepton_x86_64"
+stage="$aosp/repro-rootfs-auto"
+target="$stage/rootfs"
+
+[[ -d "$aosp/.repo" ]] || { echo "Not an AOSP checkout" >&2; exit 1; }
+[[ -f "$product/system.img" && -f "$product/vendor.img" ]] || {
+    echo "Missing Android images" >&2
+    exit 1
+}
+[[ ! -e "$target" && ! -L "$target" ]] || {
+    echo "Refusing to overwrite $target" >&2
+    exit 1
+}
+
+for tool in simg2img sqfs2tar tar unzip fuse2fs fusermount3 rsync; do
+    command -v "$tool" >/dev/null || {
+        echo "Missing required tool: $tool" >&2
+        exit 1
+    }
+done
+
+mkdir -p "$stage"
+tmp="$(mktemp -d "$stage/.package-XXXXXXXX")"
+mounted=''
+
+cleanup() {
+    if [[ -n "$mounted" ]]; then
+        fusermount3 -u "$mounted" || true
+    fi
+    rm -rf -- "$tmp"
+}
+trap cleanup EXIT
+
+echo "Converting Android sparse images..."
+for part in system vendor; do
+    simg2img "$product/$part.img" "$tmp/$part.raw.img"
+done
+
+echo "Extracting system and vendor..."
+sqfs2tar "$tmp/system.raw.img" > "$tmp/rootfs.tar"
+sqfs2tar -r vendor "$tmp/vendor.raw.img" > "$tmp/vendor.tar"
+tar -A -f "$tmp/rootfs.tar" "$tmp/vendor.tar"
+
+mkdir "$tmp/rootfs"
+tar -xf "$tmp/rootfs.tar" -C "$tmp/rootfs"
+
+echo "Flattening APEX packages..."
+shopt -s nullglob
+count=0
+
+for apex in "$tmp/rootfs"/{system,vendor}/apex/*.apex; do
+    unpack="$tmp/apex-unpack"
+    mountdir="$tmp/apex-mount"
+    dest="${apex%.apex}"
+
+    mkdir -p "$unpack" "$mountdir" "$dest"
+    unzip -q "$apex" -d "$unpack"
+    fuse2fs -o fakeroot "$unpack/apex_payload.img" "$mountdir"
+    mounted="$mountdir"
+
+    rsync -a --exclude='lost+found' "$mountdir/" "$dest/"
+
+    fusermount3 -u "$mounted"
+    mounted=''
+
+    rm -rf -- "$unpack" "$mountdir"
+    rm -- "$apex"
+    ((count += 1))
+done
+
+[[ -f "$tmp/rootfs/system/build.prop" ]]
+[[ -f "$tmp/rootfs/vendor/lib64/hw/vulkan.radeon.so" ]]
+[[ ! -e "$target" && ! -L "$target" ]]
+
+mv "$tmp/rootfs" "$target"
+
+echo "PASS: Flattened $count APEX packages"
+echo "PASS: Reproduced rootfs available at $target"
diff --git a/image-14/scripts/snapshot-worktree-patches.sh b/image-14/scripts/snapshot-worktree-patches.sh
new file mode 100755
index 0000000000000000000000000000000000000000..1d7d901e899bfb4cbef932fd3830d3873452d775
--- /dev/null
+++ b/image-14/scripts/snapshot-worktree-patches.sh
@@ -0,0 +1,99 @@
+#!/usr/bin/env bash
+# Capture current Lepton x86_64 source changes without staging/committing to the real index.
+# Install under image-14/scripts/ and run: bash scripts/snapshot-worktree-patches.sh
+set -Eeuo pipefail
+
+IMAGE_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
+COMPAT_DIR="$(cd -- "$IMAGE_DIR/../compat_tool" && pwd -P)"
+AOSP_DIR="$(readlink -f -- "$IMAGE_DIR/aosp-output")"
+
+if [[ ! -d "$AOSP_DIR/external/minigbm/.git" && ! -f "$AOSP_DIR/external/minigbm/.git" ]]; then
+    echo "ERROR: expected a Git checkout at $AOSP_DIR/external/minigbm" >&2
+    exit 1
+fi
+if ! git -C "$IMAGE_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1 ||
+   ! git -C "$COMPAT_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1 ||
+   ! git -C "$AOSP_DIR/external/mesa" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
+    echo "ERROR: image-14, compat_tool and AOSP Mesa must be Git working trees" >&2
+    exit 1
+fi
+
+mkdir -p -- "$IMAGE_DIR/patches/snapshots"
+OUT="$(mktemp -d "$IMAGE_DIR/patches/snapshots/run-XXXXXXXX")"
+printf 'Generated: %s\n' "$(date -Is)" > "$OUT/BASE_COMMITS.txt"
+printf 'Snapshots are raw, unreviewed, current working-tree changes.\n' >> "$OUT/BASE_COMMITS.txt"
+printf 'They may contain obsolete AMD/DRI code or duplicate the Mesa zstd patch.\n\n' >> "$OUT/BASE_COMMITS.txt"
+
+ALT_INDEX=''
+cleanup_index() {
+    if [[ -n "$ALT_INDEX" ]]; then
+        rm -f -- "$ALT_INDEX" "$ALT_INDEX.lock"
+    fi
+}
+trap cleanup_index EXIT
+
+capture() {
+    local label="$1" repo="$2"; shift 2
+    local outfile="$OUT/${label}.DRAFT.patch"
+
+    printf '\n[%s]\n' "$label" >> "$OUT/BASE_COMMITS.txt"
+    printf 'requested_directory=%s\n' "$repo" >> "$OUT/BASE_COMMITS.txt"
+    printf 'git_root=%s\n' "$(git -C "$repo" rev-parse --show-toplevel)" >> "$OUT/BASE_COMMITS.txt"
+    printf 'base_commit=%s\n' "$(git -C "$repo" rev-parse HEAD)" >> "$OUT/BASE_COMMITS.txt"
+    git -C "$repo" status --short --untracked-files=normal > "$OUT/${label}.status.txt"
+
+    # Build a temporary index starting at HEAD: includes new/untracked files while
+    # avoiding writes to the user's real staging area (.git/index).
+    ALT_INDEX="$(mktemp "$OUT/.alt-index-XXXXXXXX")"
+    rm -f -- "$ALT_INDEX"
+    GIT_INDEX_FILE="$ALT_INDEX" git -C "$repo" read-tree HEAD
+    GIT_INDEX_FILE="$ALT_INDEX" git -C "$repo" add -A -- "$@"
+    GIT_INDEX_FILE="$ALT_INDEX" git -C "$repo" diff --cached --binary --full-index HEAD > "$outfile"
+    cleanup_index
+    ALT_INDEX=''
+    if [[ -s "$outfile" ]]; then
+        echo "Captured: $(basename "$outfile") ($(wc -c < "$outfile") bytes)"
+    else
+        echo "No selected changes for: $label"
+    fi
+}
+
+# These two snapshots intentionally include experimental work. Review before use.
+capture minigbm "$AOSP_DIR/external/minigbm" .
+capture mesa-android "$AOSP_DIR/external/mesa" android
+
+# Scope the main repositories, avoiding generated output, symlinks and binary images.
+image_paths=(android_device_valve_lepton .buildscripts/container.sh)
+[[ -f "$IMAGE_DIR/.buildscripts/package_rootfs.sh" ]] && image_paths+=(.buildscripts/package_rootfs.sh)
+[[ -d "$IMAGE_DIR/scripts" ]] && image_paths+=(scripts)
+capture lepton-image "$IMAGE_DIR" "${image_paths[@]}"
+
+compat_paths=(liblepton)
+[[ -d "$COMPAT_DIR/images/rootfs_overlay" ]] && compat_paths+=(images/rootfs_overlay)
+shopt -s nullglob
+for test_script in "$COMPAT_DIR"/test-[0-9][0-9][0-9][0-9].sh; do
+    compat_paths+=("$(basename "$test_script")")
+done
+shopt -u nullglob
+capture lepton-runtime "$COMPAT_DIR" "${compat_paths[@]}"
+
+cat > "$OUT/README.txt" <<'INFO'
+PATCH CAPTURE — REVIEW REQUIRED
+================================
+Each *.DRAFT.patch is a snapshot against the base commit recorded in
+BASE_COMMITS.txt. Apply patches from the corresponding git_root directory,
+not blindly from image-14. No source/index changes were made to capture them.
+
+minigbm: may include obsolete AMD/legacy DRI experimental code alongside the
+          working Waydroid GBM/Mesa backend. Clean/split before finalization.
+mesa-android: may overlap the existing 0001 SDK34 zstd patch; do NOT apply both
+              without inspecting the diff.
+lepton-image: device config and build helper changes from the image checkout.
+lepton-runtime: runtime library changes and numbered test scripts.
+
+Next: review git diff and patches, remove experiments, promote to ordered
+patches, update build-images-x86_64.sh to apply all required patches, then
+verify clean Git checkouts + rebuilt images + tests 0100–0600.
+INFO
+printf '\nPatch snapshots saved to: %s\n' "$OUT"
+printf 'Source checkouts and their actual Git index were not modified.\n'
