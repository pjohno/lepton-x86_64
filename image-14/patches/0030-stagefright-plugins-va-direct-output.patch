+// Lepton: direct output of one decoded VA frame. Fetches an Android buffer
+// (imported as a VA surface), has the GPU convert into it, and waits for the
+// GPU before the buffer can reach the framework. On success mFrame is the
+// buffer's frame; on failure mFrame is untouched and the buffer is released.
+int C2FFMPEGVideoDecodeComponent::outputDirect(AVFrame* decoded) {
+    AVHWFramesContext* hwfc = (AVHWFramesContext*)decoded->hw_frames_ctx->data;
+    VADisplay display = ((AVVAAPIDeviceContext*)hwfc->device_ctx->hwctx)->display;
+    {
+        ScopedStepTime t(mTimes.sync);
+        if (vaSyncSurface(display, (VASurfaceID)(uintptr_t)decoded->data[3]) != VA_STATUS_SUCCESS) {
+            return AVERROR(EIO);
+        }
+    }
+    AVFrame* out = av_frame_alloc();
+    if (!out) return AVERROR(ENOMEM);
+    int ret;
+    {
+        ScopedStepTime t(mTimes.fetch);
+        ret = getBufferVAAPI((AVHWFramesContext*)mCtx->hw_frames_ctx->data, out, true);
+    }
+    if (ret >= 0) {
+        out->hw_frames_ctx = av_buffer_ref(mCtx->hw_frames_ctx);
+        if (!out->hw_frames_ctx) ret = AVERROR(ENOMEM);
+    }
+    if (ret >= 0) {
+        ScopedStepTime t(mDirectSubmitUs);
+        ret = vaapi_vpp_convert(decoded, out);
+    }
+    if (ret >= 0) {
+        // The decoded surface stays referenced until the conversion is done.
+        ScopedStepTime t(mDirectSyncUs);
+        if (vaSyncSurface(display, (VASurfaceID)(uintptr_t)out->data[3]) != VA_STATUS_SUCCESS) {
+            ret = AVERROR(EIO);
+        }
+    }
+    if (ret >= 0) ret = av_frame_copy_props(out, decoded);
+    if (ret >= 0 && mDirectValidation == DirectValidation::Fallback && mDirectFrames == 3) {
+        ALOGI("LEPTON_VA_DIRECT_TEST forced failure (direct-validation=fallback)");
+        ret = AVERROR(EIO);
+    }
+    if (ret >= 0 && mDirectValidation == DirectValidation::Pixels &&
+            (mDirectFrames == 5 || mDirectFrames == 30)) {
+        compareDirectPlanes(decoded, (VASurfaceID)(uintptr_t)out->data[3]);
+    }
+    if (ret >= 0) {
+        if (!mDirectFrames) {
+            ALOGI("LEPTON_VA_DIRECT input=%s output=%s picture=%dx%d buffer=%dx%d",
+                  av_get_pix_fmt_name(hwfc->sw_format),
+                  mUtils->getPixelFormat(false) == HAL_PIXEL_FORMAT_YV12 ? "yv12" : "rgb",
+                  decoded->width, decoded->height, out->width, out->height);
+        }
+        // Crop to the picture; the buffer is aligned to 64.
+        out->width = decoded->width;
+        out->height = decoded->height;
+        av_frame_unref(mFrame);
+        av_frame_move_ref(mFrame, out);
+        mDirectFrames++;
+    }
+    av_frame_free(&out);
+    return ret;
+}
