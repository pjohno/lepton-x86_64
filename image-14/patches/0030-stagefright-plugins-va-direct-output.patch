+void C2FFMPEGVideoDecodeComponent::clearCopyBackVpp() {
+    avfilter_graph_free(&mCopyBackVppGraph);
+    av_buffer_unref(&mCopyBackVppInput);
+    mCopyBackVppSource = mCopyBackVppSink = nullptr;
+}
+
+int C2FFMPEGVideoDecodeComponent::initCopyBackVpp() {
+    clearCopyBackVpp();
+    if (mVppValidation == VppValidation::InitError) {
+        ALOGI("LEPTON_VA_VPP_INJECT init");
+        return AVERROR(ENOSYS);
+    }
+    const AVFilter* buffer = avfilter_get_by_name("buffer");
+    const AVFilter* scale = avfilter_get_by_name("scale_vaapi");
+    const AVFilter* sink = avfilter_get_by_name("buffersink");
+    if (!buffer || !scale || !sink) return AVERROR(ENOSYS);
+
+    mCopyBackVppGraph = avfilter_graph_alloc();
+    if (!mCopyBackVppGraph) return AVERROR(ENOMEM);
+    mCopyBackVppGraph->nb_threads = 1;
+    mCopyBackVppSource = avfilter_graph_alloc_filter(mCopyBackVppGraph, buffer, "p010");
+    if (!mCopyBackVppSource) return AVERROR(ENOMEM);
+
+    AVBufferSrcParameters* params = av_buffersrc_parameters_alloc();
+    if (!params) return AVERROR(ENOMEM);
+    params->format = AV_PIX_FMT_VAAPI;
+    params->hw_frames_ctx = mFrame->hw_frames_ctx;
+    params->width = mFrame->width;
+    params->height = mFrame->height;
+    params->sample_aspect_ratio = mFrame->sample_aspect_ratio;
+    params->time_base = AVRational{1, 1000000};
+    params->color_space = mFrame->colorspace;
+    params->color_range = mFrame->color_range;
+
+    int err = av_buffersrc_parameters_set(mCopyBackVppSource, params);
+    av_free(params);
+    if (err < 0) return err;
+    err = avfilter_init_str(mCopyBackVppSource, nullptr);
+    if (err < 0) return err;
+    AVFilterContext* scaler = nullptr;
+    err = avfilter_graph_create_filter(&scaler, scale, "vpp", "format=nv12",
+                                      nullptr, mCopyBackVppGraph);
+    if (err < 0) return err;
+    err = avfilter_graph_create_filter(&mCopyBackVppSink, sink, "nv12", nullptr,
+                                      nullptr, mCopyBackVppGraph);
+    if (err < 0) return err;
+    err = avfilter_link(mCopyBackVppSource, 0, scaler, 0);
+    if (err < 0) return err;
+    err = avfilter_link(scaler, 0, mCopyBackVppSink, 0);
+    if (err < 0) return err;
+    err = avfilter_graph_config(mCopyBackVppGraph, nullptr);
+    if (err < 0) return err;
+
+    mCopyBackVppInput = av_buffer_ref(mFrame->hw_frames_ctx);
+    if (!mCopyBackVppInput) return AVERROR(ENOMEM);
+    mCopyBackVppWidth = mFrame->width;
+    mCopyBackVppHeight = mFrame->height;
+    ALOGI("LEPTON_VA_VPP input=p010 output=nv12 size=%dx%d", mFrame->width, mFrame->height);
+    return 0;
+}
+
+bool C2FFMPEGVideoDecodeComponent::tryCopyBackVpp(VADisplay display) {
+    int err = 0;
+    if (!mCopyBackVppInput || mCopyBackVppInput->data != mFrame->hw_frames_ctx->data ||
+            mCopyBackVppWidth != mFrame->width || mCopyBackVppHeight != mFrame->height) {
+        err = initCopyBackVpp();
+    }
+    AVFrame* surface = err >= 0 ? av_frame_alloc() : nullptr;
+    AVFrame* output = err >= 0 ? av_frame_alloc() : nullptr;
+    if (err >= 0 && (!surface || !output)) err = AVERROR(ENOMEM);
+    if (err >= 0) {
+        ScopedStepTime t(mCopyBackVppSubmitUs);
+        err = av_buffersrc_add_frame_flags(mCopyBackVppSource, mFrame, AV_BUFFERSRC_FLAG_KEEP_REF);
+        if (err >= 0) err = av_buffersink_get_frame(mCopyBackVppSink, surface);
+    }
+    if (err >= 0 && (surface->format != AV_PIX_FMT_VAAPI ||
+            surface->width != mFrame->width || surface->height != mFrame->height)) {
+        err = AVERROR(EINVAL);
+    }
+    if (err >= 0) {
+        ScopedStepTime t(mCopyBackVppSyncUs);
+        if (vaSyncSurface(display, (VASurfaceID)(uintptr_t)surface->data[3]) != VA_STATUS_SUCCESS) {
+            err = AVERROR(EIO);
+        }
+    }
+    if (err >= 0 && mVppValidation == VppValidation::FrameError && mCopyBackVppFrames == 3) {
+        ALOGI("LEPTON_VA_VPP_INJECT frame");
+        err = AVERROR(EIO);
+    }
+    if (err >= 0) {
+        const int64_t start = leptonNowUs();
+        output->format = AV_PIX_FMT_NV12;
+        if (mDeriveDownload) {
+            err = av_hwframe_map(output, surface, AV_HWFRAME_MAP_READ | AV_HWFRAME_MAP_DIRECT);
+        } else {
+            err = AVERROR(ENOSYS);
+        }
+        if (err < 0) {
+            av_frame_unref(output);
+            output->format = AV_PIX_FMT_NV12;
+            err = av_hwframe_transfer_data(output, surface, 0);
+        }
+        const int64_t elapsed = leptonNowUs() - start;
+        mTimes.download += elapsed;
+        mCopyBackVppReadUs += elapsed;
+        if (err >= 0) err = av_frame_copy_props(output, mFrame);
+    }
+    if (err >= 0) {
+        if (mVppValidation == VppValidation::Pixels) compareVppPlanes(output);
+        av_frame_unref(mFrame);
+        av_frame_move_ref(mFrame, output);
+        ++mCopyBackVppFrames;
+    } else {
+        // The original decode frame stayed referenced throughout submission and readback.
+        ALOGW("LEPTON_VA_VPP fallback=%s", av_err2str(err));
+        clearCopyBackVpp();
+        mCopyBackVppFailed = true;
+    }
+    av_frame_free(&output);
+    av_frame_free(&surface);
+    return err >= 0;
+}
+
+void C2FFMPEGVideoDecodeComponent::compareVppPlanes(const AVFrame* nv12) {
+    switch (mCopyBackVppFrames) {
+        case 10: case 119: case 120: case 263: case 264: case 315: break;
+        default: return;
+    }
+
+    AVFrame* p010 = av_frame_alloc();
+    if (!p010) return;
+    p010->format = AV_PIX_FMT_P010;
+    const int err = av_hwframe_transfer_data(p010, mFrame, 0);
+    if (err < 0) {
+        ALOGE("LEPTON_VA_VPP_PIXELS reference download failed: %s", av_err2str(err));
+        av_frame_free(&p010);
+        return;
+    }
+
+    ALOGI("LEPTON_VA_VPP_LAYOUT frame=%" PRIu64 " pts=%" PRId64 " size=%dx%d crop=%zu,%zu,%zu,%zu"
+          " p010_strides=%d,%d nv12_strides=%d,%d",
+          mCopyBackVppFrames, nv12->best_effort_timestamp, nv12->width, nv12->height,
+          nv12->crop_left, nv12->crop_top, nv12->crop_right, nv12->crop_bottom,
+          p010->linesize[0], p010->linesize[1], nv12->linesize[0], nv12->linesize[1]);
+
+    for (int component = 0; component < 3; ++component) {
+        const int plane = component > 0;
+        const int width = nv12->width >> plane;
+        const int height = nv12->height >> plane;
+        const int pitch = plane ? 2 : 1;
+        const int offset = component == 2;
+        int maxError = 0, peakX = 0, peakY = 0;
+        int64_t absoluteSum = 0, signedSum = 0, outsideOne = 0, locallyFlat = 0;
+        for (int y = 0; y < height; ++y) {
+            const auto* in = reinterpret_cast<const uint16_t*>(p010->data[plane] + y * p010->linesize[plane]);
+            const auto* out = nv12->data[plane] + y * nv12->linesize[plane];
+            for (int x = 0; x < width; ++x) {
+                const int index = x * pitch + offset;
+                const int expected = std::min(255, (in[index] + 128) >> 8);
+                const int diff = out[index] - expected;
+                const int magnitude = std::abs(diff);
+                if (magnitude > maxError) {
+                    maxError = magnitude;
+                    peakX = x;
+                    peakY = y;
+                }
+                absoluteSum += magnitude;
+                signedSum += diff;
+                if (magnitude > 1) {
+                    ++outsideOne;
+                    const auto* above = reinterpret_cast<const uint16_t*>(
+                        p010->data[plane] + std::max(0, y - 1) * p010->linesize[plane]);
+                    const auto* below = reinterpret_cast<const uint16_t*>(
+                        p010->data[plane] + std::min(height - 1, y + 1) * p010->linesize[plane]);
+                    const uint16_t left = in[std::max(0, x - 1) * pitch + offset];
+                    const uint16_t right = in[std::min(width - 1, x + 1) * pitch + offset];
+                    const int spread = std::max({in[index], left, right, above[index], below[index]}) -
+                                       std::min({in[index], left, right, above[index], below[index]});
+                    locallyFlat += spread <= 256;
+                }
+            }
+        }
+        const double count = static_cast<double>(width) * height;
+        ALOGI("LEPTON_VA_VPP_PIXELS frame=%" PRIu64 " plane=%c max=%d mae=%.5f bias=%+.5f"
+              " gt1=%" PRId64 " gt1_flat=%" PRId64 " peak=%d,%d",
+              mCopyBackVppFrames, "YUV"[component], maxError, absoluteSum / count,
+              signedSum / count, outsideOne, locallyFlat, peakX, peakY);
+    }
+    av_frame_free(&p010);
+}
