+// Lepton (direct-validation=pixels): compare a direct-output buffer, read on the
+// CPU, with the decoded surface downloaded by FFmpeg.
+void C2FFMPEGVideoDecodeComponent::compareDirectPlanes(AVFrame* decoded, VASurfaceID surface) {
+    auto held = mHeldSurfaces.find(surface);
+    if (held == mHeldSurfaces.end() || !held->second) return;
+    AVFrame* ref = av_frame_alloc();
+    if (!ref) return;
+    if (av_hwframe_transfer_data(ref, decoded, 0) < 0) { av_frame_free(&ref); return; }
+    const bool tenBit = ref->format == AV_PIX_FMT_P010;
+    C2GraphicView view = held->second->map().get();
+    if (view.error() != C2_OK) { av_frame_free(&ref); return; }
+    const C2PlanarLayout layout = view.layout();
+    const int planes[3] = { C2PlanarLayout::PLANE_Y, C2PlanarLayout::PLANE_U, C2PlanarLayout::PLANE_V };
+    for (int c = 0; c < 3; ++c) {
+        const int sub = c > 0;
+        const int w = decoded->width >> sub, h = decoded->height >> sub;
+        const uint8_t* dst = view.data()[planes[c]];
+        const int rowInc = layout.planes[planes[c]].rowInc, colInc = layout.planes[planes[c]].colInc;
+        int peak = 0; int64_t sum = 0, sumAbs = 0, inexact = 0;
+        for (int y = 0; y < h; ++y) {
+            for (int x = 0; x < w; ++x) {
+                int expect;
+                if (tenBit) {
+                    const uint16_t* row = (const uint16_t*)(ref->data[sub] + y * ref->linesize[sub]);
+                    expect = std::min(255, (row[sub ? 2 * x + (c - 1) : x] + 128) >> 8);
+                } else {
+                    expect = ref->data[sub][y * ref->linesize[sub] + (sub ? 2 * x + (c - 1) : x)];
+                }
+                const int d = dst[y * rowInc + x * colInc] - expect;
+                sum += d; sumAbs += std::abs(d); inexact += d != 0;
+                peak = std::max(peak, std::abs(d));
+            }
+        }
+        const int cx = w / 3, cy = h / 2;
+        int expectMid = tenBit ? (((const uint16_t*)(ref->data[sub] + cy * ref->linesize[sub]))[sub ? 2 * cx + (c - 1) : cx] + 128) >> 8
+                               : ref->data[sub][cy * ref->linesize[sub] + (sub ? 2 * cx + (c - 1) : cx)];
+        ALOGI("LEPTON_VA_DIRECT_PIXELS frame=%" PRIu64 " plane=%c inexact=%" PRId64 "/%d peak=%d mean=%.3f mean_abs=%.3f"
+              " sample=%d expect=%d rowInc=%d colInc=%d",
+              mDirectFrames, "YUV"[c], inexact, w * h, peak, (double)sum / (w * h), (double)sumAbs / (w * h),
+              dst[cy * rowInc + cx * colInc], expectMid, rowInc, colInc);
+    }
+    av_frame_free(&ref);
+}
