+        // build saturates decoded peaks above full scale to flat tops, which
+        // crackle on loud music; the float build soft-clips them instead
+        // (opus_decode/opus_multistream_decode with soft_clip). Host builds
+        // and other architectures are unchanged.
+        android_x86_64: {
+            cflags: ["-UFIXED_POINT"],
