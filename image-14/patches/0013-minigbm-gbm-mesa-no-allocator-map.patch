Lepton: gbm_mesa allocator never maps buffers (Codec2 BLOB pools on AMD)

gbm_mesa_alloc() imported and mapped every CPU-usage buffer right after
creating it, only to record a "map stride". Nothing reads that value
(gbm_mesa_bo_get_map_stride has no callers; CPU mappings use the buffer
strides). On radeonsi the probe map goes through a staging texture, and the
compute copy behind it crashed the allocator with a null compute program
(si_launch_grid_internal / si_setup_nir_user_data). Codec2's BLOB pools
(debug.stagefright.c2-poolmask with the BLOB bit, as Valve's Lepton uses)
allocate exactly such buffers at boot, so the allocator died, SurfaceFlinger
followed and Android powered off.

Drop the probe and record the allocation stride. Export a marker string so the
launcher can tell images with this fix from older ones.

diff --git a/gbm_mesa_driver/gbm_mesa_wrapper.cpp b/gbm_mesa_driver/gbm_mesa_wrapper.cpp
index fb5af2b..46388cd 100644
--- a/gbm_mesa_driver/gbm_mesa_wrapper.cpp
+++ b/gbm_mesa_driver/gbm_mesa_wrapper.cpp
@@ -117,6 +117,12 @@ static void gbm_mesa_dev_destroy(struct gbm_device *gbm)
 	gbm_device_destroy(gbm);
 }
 
+/* Lepton: marks an allocator that never maps buffers itself. The launcher
+ * looks for this string before letting Codec2 allocate BLOB buffers through
+ * gralloc, which crashed allocators built without it on AMD. */
+extern "C" __attribute__((visibility("default"), used)) const char
+	lepton_gbm_allocator_no_map_probe[] = "lepton-gbm-allocator-no-map-probe";
+
 // ALLOCATOR_ONLY!
 static int gbm_mesa_alloc(struct alloc_args *args)
 {
@@ -160,35 +166,13 @@ static int gbm_mesa_alloc(struct alloc_args *args)
 	/* Buffer is now handled through the system via out_fd, we can now destroy gbm_mesa bo */
 	gbm_bo_destroy(bo);
 
-	if (args->needs_map_stride) {
-		/* At least on Intel and nouveau map_stride after gbm_create is different from
-		 * map_stride after gbm_import, We care only about map_stride after importing. */
-		struct gbm_import_fd_modifier_data data = {
-			.width = args->width,
-			.height = args->height,
-			.format = gbm_format,
-			.num_fds = 1,
-			.fds[0] = args->out_fd,
-			.strides[0] = (int)args->out_stride,
-			.modifier = args->out_modifier,
-		};
-		void *addr = NULL;
-		void *map_data = NULL;
-
-		bo = gbm_bo_import(args->gbm, GBM_BO_IMPORT_FD_MODIFIER, &data, 0);
-
-		int flags = GBM_BO_TRANSFER_READ | GBM_BO_TRANSFER_WRITE;
-
-		addr = gbm_bo_map(bo, 0, 0, args->width, args->height, flags, &args->out_map_stride,
-				  &map_data);
-		if (addr == NULL) {
-			ALOGE("Failed to map the buffer at %s:%d", __FILE__, __LINE__);
-		} else {
-			gbm_bo_unmap(bo, map_data);
-		}
-
-		gbm_bo_destroy(bo);
-	}
+	/* Lepton: the stride probe that used to map the buffer here is not needed:
+	 * its result (map_stride) is never read, and CPU mappings use the buffer
+	 * strides. On radeonsi the probe mapped through a staging texture, and the
+	 * compute copy behind it crashed the allocator (null compute program in
+	 * si_launch_grid_internal), taking SurfaceFlinger down. Never touch buffer
+	 * contents in the allocator. */
+	args->out_map_stride = args->out_stride;
 
 	return 0;
 }
