Lepton: gbm_mesa imports and maps BLOB buffers as allocated (Intel Codec2)

gbm_mesa_bo_create allocates a 1D buffer (R8, height 1: HAL_PIXEL_FORMAT_BLOB,
and formats gbm cannot describe) as a linear 4096 x ceil(W/4096) R8 surface.
gbm_mesa_bo_import and gbm_mesa_bo_map instead described it as W x 1 with the
real 4096-byte stride, a row wider than its stride for any buffer over 4 KiB.
iris rejects that import, so every Codec2 BLOB lock failed on Intel
(C2AllocatorGralloc: failed transaction: lock(BLOB)) and media apps were
silent. radeonsi ignores the stride and maps through a staging copy, which is
why AMD worked.

Describe the allocated surface in one helper used by import and map, log a
failed CPU-access import, and refuse to map a null gbm bo. Export a marker
string so the launcher can tell images with this fix from older ones.

diff --git a/gbm_mesa_driver/gbm_mesa_internals.cpp b/gbm_mesa_driver/gbm_mesa_internals.cpp
--- a/gbm_mesa_driver/gbm_mesa_internals.cpp
+++ b/gbm_mesa_driver/gbm_mesa_internals.cpp
@@ -303,6 +303,44 @@
 	}
 }
 
+/* Lepton: marks a gralloc whose CPU import/map match the allocated surface.
+ * The launcher looks for this string before letting Codec2 lock BLOB buffers
+ * through gralloc on Intel, where older images fail every lock. */
+extern "C" __attribute__((visibility("default"), used)) const char
+	lepton_gbm_blob_cpu_surface[] = "lepton-gbm-blob-cpu-surface";
+
+/* 1D (R8, height 1) buffers are allocated as linear 2D R8 surfaces this wide. */
+#define GBM_MESA_1D_SURFACE_WIDTH 4096
+
+/* Lepton: the gbm surface a CPU-mapped buffer was allocated as, so import and
+ * map describe the same surface as gbm_mesa_bo_create. Without this, a BLOB
+ * buffer allocated as 4096 x N was imported as W x 1 with a 4096-byte stride.
+ * iris rejects that import (row wider than its stride), so every Codec2 BLOB
+ * lock failed on Intel and media apps were silent; radeonsi ignored the
+ * stride and mapped through a staging copy instead. */
+static void gbm_mesa_cpu_surface(bool gbm_format_supported, uint32_t format, uint32_t width,
+				 uint32_t height, uint64_t total_size, uint32_t *s_format,
+				 int *s_width, int *s_height)
+{
+	if (!gbm_format_supported) {
+		/* Spoofed formats were allocated as one 1D buffer of total_size. */
+		format = DRM_FORMAT_R8;
+		width = total_size;
+		height = 1;
+	}
+	if (format == DRM_FORMAT_R8 && height == 1) {
+		height = DIV_ROUND_UP(width, GBM_MESA_1D_SURFACE_WIDTH);
+		width = GBM_MESA_1D_SURFACE_WIDTH;
+	} else if (format == DRM_FORMAT_YVU420_ANDROID) {
+		uint32_t luma_height = height;
+		height += DIV_ROUND_UP(luma_height, 2);
+		width = ALIGN(width / 2, 512);
+	}
+	*s_format = format;
+	*s_width = (int)width;
+	*s_height = (int)height;
+}
+
 int gbm_mesa_bo_create(struct bo *bo, uint32_t width, uint32_t height, uint32_t format,
 		       uint64_t use_flags)
 {
@@ -348,8 +386,8 @@
 		/* Some mesa drivers may not support 1D allocations.
 		 * Use 2D texture with 4096 width instead.
 		 */
-		alloc_args.height = DIV_ROUND_UP(alloc_args.width, 4096);
-		alloc_args.width = 4096;
+		alloc_args.height = DIV_ROUND_UP(alloc_args.width, GBM_MESA_1D_SURFACE_WIDTH);
+		alloc_args.width = GBM_MESA_1D_SURFACE_WIDTH;
 		drv_logv("Allocate 1D buffer as %dx%d R8 2D texture", alloc_args.width,
 			 alloc_args.height);
 	}
@@ -426,22 +464,17 @@
 		auto drv = gbm_mesa_get_or_init_driver(bo->drv, true);
 		auto wr = drv->wrapper;
 
-		uint32_t s_format = data->format;
-		int s_height = data->height;
-		int s_width = data->width;
-		if (wr->get_gbm_format(s_format) == 0) {
-			s_width = bo->meta.total_size;
-			s_height = 1;
-			s_format = DRM_FORMAT_R8;
-		}
-		if (s_format == DRM_FORMAT_YVU420_ANDROID) {
-			s_width /= 2;
-			s_height += DIV_ROUND_UP(data->height, 2);
-			s_width = ALIGN(s_width, 512);
-		}
+		uint32_t s_format;
+		int s_width, s_height;
+		gbm_mesa_cpu_surface(wr->get_gbm_format(data->format) != 0, data->format,
+				     data->width, data->height, bo->meta.total_size, &s_format,
+				     &s_width, &s_height);
 		priv->drv = drv;
 		priv->gbm_bo = wr->import(drv->gbm_dev, data->fds[0], s_width, s_height,
 					  data->strides[0], data->format_modifier, s_format);
+		if (!priv->gbm_bo)
+			drv_loge("Failed to import %dx%d surface (format 0x%08x, stride %u) for CPU access",
+				 s_width, s_height, s_format, data->strides[0]);
 	}
 
 	bo->priv = priv;
@@ -473,23 +506,19 @@
 	vma->length = bo->meta.total_size;
 
 	auto priv = (GbmMesaBoPriv *)bo->priv;
-	assert(priv->gbm_bo != nullptr);
-
 	void *buf = MAP_FAILED;
-
-	uint32_t s_format = bo->meta.format;
-	int s_width = bo->meta.width;
-	int s_height = bo->meta.height;
-	if (wr->get_gbm_format(s_format) == 0) {
-		s_width = bo->meta.total_size;
-		s_height = 1;
-	}
-	if (s_format == DRM_FORMAT_YVU420_ANDROID) {
