+	gbm_mesa_cpu_surface(wr->get_gbm_format(bo->meta.format) != 0, bo->meta.format,
+			     bo->meta.width, bo->meta.height, bo->meta.total_size, &s_format,
+			     &s_width, &s_height);
+
 	wr->map(priv->gbm_bo, s_width, s_height, &buf, &vma->priv);
 
