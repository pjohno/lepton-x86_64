+// Lepton: one line when a session's first frame arrives, saying whether
+// frames come from VA-API or FFmpeg decodes in software, and why.
+void C2FFMPEGVideoDecodeComponent::noteDecodedFrame() {
+    const bool hw = mFrame->format == AV_PIX_FMT_VAAPI;
+    if (hw) mHwFrames++; else mSwFrames++;
+    if (mSessionLogged) return;
+    mSessionLogged = true;
+    const char* reason = "";
+    if (!hw) {
+        if (!base::GetBoolProperty("media.sf.hwaccel", false)) {
+            reason = "hwaccel-off";
+        } else if (!mCtx->hw_device_ctx) {
+            reason = "no-va-device-or-codec";
+        } else {
+            reason = "va-cannot-decode-stream";  // e.g. unsupported profile or bit depth
+        }
+    }
+    const char* profile = avcodec_profile_name(mCtx->codec_id, mCtx->profile);
+    const char* swFormat = "-";
+    if (hw && mFrame->hw_frames_ctx) {
+        swFormat = av_get_pix_fmt_name(((AVHWFramesContext*)mFrame->hw_frames_ctx->data)->sw_format);
+    }
+    ALOGI("LEPTON_VA_SESSION codec=%s profile=%s size=%dx%d decode=%s%s%s sw_format=%s zero_copy=%d",
+          avcodec_get_name(mCtx->codec_id), profile ? profile : "?", mFrame->width, mFrame->height,
+          hw ? "vaapi" : "software", hw ? "" : " reason=", reason, swFormat ? swFormat : "?",
+          hw && mUtils->mUseDrmPrime ? 1 : 0);
+}
+
+void C2FFMPEGVideoDecodeComponent::logSessionEnd() {
+    if (mHwFrames || mSwFrames || mTransferFailures) {
+        ALOGI("LEPTON_VA_SESSION_END codec=%s hw_frames=%" PRIu64 " sw_frames=%" PRIu64
+              " transfer_failures=%" PRIu64,
+              mCtx ? avcodec_get_name(mCtx->codec_id) : "?", mHwFrames, mSwFrames, mTransferFailures);
+    }
+    mHwFrames = mSwFrames = mTransferFailures = 0;
+    mSessionLogged = false;
+}
