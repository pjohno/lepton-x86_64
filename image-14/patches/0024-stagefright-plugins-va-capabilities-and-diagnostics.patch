+// Lepton: ask the VA-API driver (the device FFmpeg would use) which profiles
+// it can decode. Logged once as LEPTON_VA_CAPS.
+static std::string queryVaCodecs() {
+#if !CONFIG_VAAPI
+    return "";
+#else
+    using namespace ::android;
+    if (!base::GetBoolProperty("media.sf.hwaccel", false)) {
+        return "";
+    }
+    AVBufferRef* device = nullptr;
+    if (av_hwdevice_ctx_create(&device, AV_HWDEVICE_TYPE_VAAPI, "android", nullptr, 0) < 0) {
+        ALOGW("LEPTON_VA_CAPS driver=none node=%s codecs= (VA-API device could not be opened)",
+              base::GetProperty("gralloc.gbm.device", "?").c_str());
+        return "";
+    }
+    VADisplay display = ((AVVAAPIDeviceContext*)((AVHWDeviceContext*)device->data)->hwctx)->display;
+    std::vector<VAProfile> profiles(vaMaxNumProfiles(display));
+    int numProfiles = 0;
+    std::string tokens, decodable;
+    if (vaQueryConfigProfiles(display, profiles.data(), &numProfiles) == VA_STATUS_SUCCESS) {
+        std::vector<VAEntrypoint> entrypoints(vaMaxNumEntrypoints(display));
+        for (int i = 0; i < numProfiles; i++) {
+            int numEntrypoints = 0;
+            if (vaQueryConfigEntrypoints(display, profiles[i], entrypoints.data(), &numEntrypoints)
+                    != VA_STATUS_SUCCESS) {
+                continue;
+            }
+            bool vld = false;
+            for (int e = 0; e < numEntrypoints; e++) vld |= entrypoints[e] == VAEntrypointVLD;
+            if (!vld) continue;
+            const char* token = nullptr;
+            switch (profiles[i]) {
+                case VAProfileH264ConstrainedBaseline:
+                case VAProfileH264Main:
+                case VAProfileH264High: token = "H264"; break;
+                case VAProfileHEVCMain: token = "HEVC"; break;
+                case VAProfileHEVCMain10: token = "HEVC10"; break;
+                case VAProfileVP8Version0_3: token = "VP80"; break;
+                case VAProfileVP9Profile0: token = "VP90"; break;
+                case VAProfileVP9Profile2: token = "VP92"; break;
+                case VAProfileAV1Profile0: token = "AV10"; break;
+                case VAProfileMPEG2Simple:
+                case VAProfileMPEG2Main: token = "MPG2"; break;
+                case VAProfileMPEG4Simple:
+                case VAProfileMPEG4AdvancedSimple:
+                case VAProfileMPEG4Main: token = "MPG4"; break;
+                case VAProfileH263Baseline: token = "H263"; break;
+                default: break;
+            }
+            decodable += std::string(decodable.empty() ? "" : ",") + vaProfileStr(profiles[i]);
+            if (token && (" " + tokens + " ").find(std::string(" ") + token + " ") == std::string::npos) {
+                tokens += std::string(tokens.empty() ? "" : " ") + token;
+            }
+        }
+    }
+    ALOGI("LEPTON_VA_CAPS driver=\"%s\" node=%s codecs=%s profiles=%s",
+          vaQueryVendorString(display), base::GetProperty("gralloc.gbm.device", "?").c_str(),
+          tokens.c_str(), decodable.c_str());
+    av_buffer_unref(&device);
+    return tokens;
+#endif
+}
+
+const std::string& C2FFMPEGVideoUtils::detectedHwCodecs() {
+    static std::once_flag once;
+    static std::string codecs;
+    std::call_once(once, [] { codecs = queryVaCodecs(); });
+    return codecs;
+}
