Lepton: closing a desktop window ends the game (Android 14 task codes)

Closing the game's window on a desktop (GNOME's Close) hid the window, but the
game and its audio kept running. HWC handles xdg_toplevel.close for the
full-UI window (task "0") by asking vendor.waydroid.task to
removeAllVisibleRecentTasks(). That service calls IActivityTaskManager over
raw binder with hard-coded transaction codes, which upstream set for Android
13 (setFocusedTask 20, removeTask 21, removeAllVisibleRecentTasks 22). On
Android 14 those methods are 19, 20 and 21, so every call ran the next method:
the close ran getTasks() and removed nothing, closing a per-task window
removed all tasks, and focusing one removed it.

Use the Android 14 codes, log binder failures in the task service instead of
dropping them, and log each close with its task, app and chosen action
(lepton.hwc.trace additionally logs configure events). The close decision is
in lepton-close.h so it can be tested on the host; a non-numeric task ID is
refused instead of aborting HWC in stoi().

diff --git a/hwcomposer/lepton-close.h b/hwcomposer/lepton-close.h
new file mode 100644
index 0000000..e5101c9
--- /dev/null
+++ b/hwcomposer/lepton-close.h
@@ -0,0 +1,47 @@
+// Lepton: what closing a desktop window asks Android to do. Header-only and
+// free of Android dependencies so the decision can be tested on the host.
+#pragma once
+
+#include <string>
+
+namespace lepton {
+
+enum class close_action {
+    remove_visible_tasks, // full-UI window (task "0"): end the game's task(s)
+    remove_task,          // per-task window: end only that task
+    window_only,          // no task behind the window ("none"): just hide it
+    no_task_service,      // vendor.waydroid.task unavailable: cannot end anything
+    invalid_task_id,      // not a task number: refuse rather than guess
+};
+
+inline bool is_task_number(const std::string &id) {
+    if (id.empty() || id.size() > 9)
+        return false;
+    for (char c : id)
+        if (c < '0' || c > '9')
+            return false;
+    return true;
+}
+
+inline close_action close_action_for(const std::string &task_id, bool have_task_service) {
+    if (task_id == "none")
+        return close_action::window_only;
+    if (!have_task_service)
+        return close_action::no_task_service;
+    if (task_id == "0")
+        return close_action::remove_visible_tasks;
+    return is_task_number(task_id) ? close_action::remove_task : close_action::invalid_task_id;
+}
+
+inline const char *close_action_name(close_action action) {
+    switch (action) {
+    case close_action::remove_visible_tasks: return "removeAllVisibleRecentTasks";
+    case close_action::remove_task: return "removeTask";
+    case close_action::window_only: return "window-only";
+    case close_action::no_task_service: return "none (no task service)";
+    case close_action::invalid_task_id: return "none (invalid task id)";
+    }
+    return "unknown";
+}
+
+} // namespace lepton
