@@ -289,6 +305,20 @@ void C2FFMPEGVideoDecodeComponent::logSessionEnd() {
               " transfer_failures=%" PRIu64,
               mCtx ? avcodec_get_name(mCtx->codec_id) : "?", mHwFrames, mSwFrames, mTransferFailures);
     }
+    if (mTimes.frames) {
+        // Average microseconds per output frame in each step. download is the
+        // GPU wait plus the map or copy; convert is swscale, which reads the
+        // mapped surface. process is the whole of Codec2's process() calls.
+        const double n = (double)mTimes.frames;
+        const int64_t wall = mTimes.lastUs - mTimes.firstUs;
+        ALOGI("LEPTON_VA_TIMING codec=%s size=%dx%d frames=%" PRIu64 " fps=%.1f us_per_frame:"
+              " send=%.0f receive=%.0f download=%.0f fetch=%.0f map=%.0f convert=%.0f process=%.0f",
+              mCtx ? avcodec_get_name(mCtx->codec_id) : "?", mTimes.width, mTimes.height,
+              mTimes.frames, wall > 0 ? (mTimes.frames - 1) * 1e6 / wall : 0.0,
+              mTimes.send / n, mTimes.receive / n, mTimes.download / n, mTimes.fetch / n,
+              mTimes.map / n, mTimes.convert / n, mTimes.process / n);
+    }
+    mTimes = StepTimes();
     mHwFrames = mSwFrames = mTransferFailures = 0;
     mSessionLogged = false;
 }
