Lepton: DRM PRIME output to plain buffers (buffer identity)

In DRM PRIME mode (direct output, patch 0030) the service keys VA surfaces
by the output block's BufferQueue slot. Only Surface output has one: blocks
for ByteBuffer output all report slot 0, so every block looked like the
same busy surface and getBufferVAAPI looped forever (the app's decode
stalled; seen with iHD). Use minigbm's per-allocation buffer id for blocks
without a BufferQueue.

The handle is read as minigbm's cros_gralloc_handle only after checking
that it carries at least one fd and is large enough for that layout, and
that its magic number matches; otherwise the id is 0 (Surface output still
works by slot).

Log each buffer imported as a VA surface (format, modifier, pitches,
offsets), one line per buffer, to diagnose layout mismatches.

--- a/codec2/C2FFMPEGVideoDecodeComponent.cpp
+++ b/codec2/C2FFMPEGVideoDecodeComponent.cpp
@@ -1399,9 +1399,26 @@
 // uses a margin of 7~8 buffers on top of configured output delay, so it's unlikely the
 // codec will stall.
 
+// Lepton: the block's handle as minigbm's cros_gralloc_handle, or null when it
+// is not one. Codec2's handle starts with the native handle's fds and ints (and
+// appends its own ints), so check it is large enough for minigbm's layout before
+// reading the magic number or any other field.
+static cros_gralloc_handle_t leptonCrosHandle(const C2Handle* handle) {
+    constexpr uint32_t kCrosGrallocMagic = 0xABCDDCBA;
+    if (!handle || handle->numFds < 1 || handle->numInts < 0) return nullptr;
+    const size_t size = sizeof(native_handle_t) +
+            sizeof(int) * (static_cast<size_t>(handle->numFds) + static_cast<size_t>(handle->numInts));
+    if (size < sizeof(struct cros_gralloc_handle)) return nullptr;
+    cros_gralloc_handle_t crosHandle = reinterpret_cast<cros_gralloc_handle_t>(handle);
+    return crosHandle->magic == kCrosGrallocMagic ? crosHandle : nullptr;
+}
+
 void C2FFMPEGVideoDecodeComponent::SurfaceDescriptor::set(const std::shared_ptr<C2GraphicBlock>& block) {
     android::_UnwrapNativeCodec2GrallocMetadata(block->handle(),
             &width, &height, &format, &usage, &stride, &generation, &igbpId, &igbpSlot);
+    // minigbm's handle (cros_gralloc_handle) carries a per-allocation id.
+    cros_gralloc_handle_t crosHandle = leptonCrosHandle(block->handle());
+    bufferId = crosHandle ? crosHandle->id : 0;
 }
 
 int C2FFMPEGVideoDecodeComponent::getBufferVAAPI(AVHWFramesContext* hwfc, AVFrame* frame, bool forceAllocator) {
@@ -1581,6 +1598,15 @@
             descriptor.layers[0].offset[3] = 0;
         }
 
+        // Lepton: one line per imported buffer, to compare gralloc's layout
+        // with what the VA driver expects.
+        ALOGI("getBufferVAAPI: import buffer %d: %ux%u fourcc %#x drm %#x modifier %#" PRIx64
+              " size %u planes %u pitch %u/%u offset %u/%u",
+              desc.getId(), descriptor.width, descriptor.height, descriptor.fourcc,
+              descriptor.layers[0].drm_format, descriptor.objects[0].drm_format_modifier,
+              descriptor.objects[0].size, descriptor.layers[0].num_planes,
+              descriptor.layers[0].pitch[0], descriptor.layers[0].pitch[1],
+              descriptor.layers[0].offset[0], descriptor.layers[0].offset[1]);
         vas = vaCreateSurfaces(hwctx->display, mUtils->getVAFormat(),
                                mSurfaceWidth, mSurfaceHeight, &surfaceId, 1, attributes, 2);
 
