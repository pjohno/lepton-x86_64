Lepton: build Mesa's VA-API driver for Android

Mesa's Android make build has no VA-API support. With
BOARD_MESA3D_GALLIUM_VA := true it now adds libva (headers and a stub
pkg-config with the VA-API version from external/libva) and configures
-Dgallium-va=enabled. On Android Mesa links the VA driver into
libgallium_dri.so (__vaDriverInit_1_23), which is where WayDroid's libva
looks for non-Intel GPUs. Which codecs it decodes is set by -Dvideo-codecs
in BOARD_MESA3D_MESON_ARGS.

Mesa's VA frontend refuses VA_DISPLAY_ANDROID (VA_STATUS_ERROR_UNIMPLEMENTED).
libva-android opens the render node into drm_state like the DRM display
types do, so handle it the same way.

diff --git a/android/Android.mk b/android/Android.mk
--- a/android/Android.mk
+++ b/android/Android.mk
@@ -104,6 +104,16 @@
 MESON_GEN_PKGCONFIGS += DirectX-Headers
 endif
 
+# Lepton: gallium VA-API frontend (BOARD_MESA3D_GALLIUM_VA := true). On Android
+# Mesa links the VA driver into libgallium_dri.so (__vaDriverInit_*), which
+# WayDroid's libva loads for non-Intel GPUs. The driver needs only libva's
+# headers; the stub pkg-config gives the VA-API version from external/libva.
+ifneq ($(filter true,$(BOARD_MESA3D_GALLIUM_VA)),)
+LIBVA_API_VERSION = $(shell sed -n "s/^va_api_major_version = \([0-9]*\)/\1/p" external/libva/meson.build).$(shell sed -n "s/^va_api_minor_version = \([0-9]*\)/\1/p" external/libva/meson.build).0
+LOCAL_SHARED_LIBRARIES += libva
+MESON_GEN_PKGCONFIGS += libva:$(LIBVA_API_VERSION)
+endif
+
 ifneq ($(MESON_GEN_LLVM_STUB),)
 MESON_LLVM_VERSION := $(LLVM_VERSION_MAJOR).0.0
 
diff --git a/android/mesa3d_cross.mk b/android/mesa3d_cross.mk
--- a/android/mesa3d_cross.mk
+++ b/android/mesa3d_cross.mk
@@ -97,6 +97,7 @@
 	-Dcpp_rtti=false                                                             \
 	-Dlmsensors=disabled                                                         \
 	-Dandroid-libbacktrace=disabled                                              \
+	-Dgallium-va=$(if $(filter true,$(BOARD_MESA3D_GALLIUM_VA)),enabled,disabled) \
 	$(BOARD_MESA3D_MESON_ARGS)                                                   \
 
 MESON_BUILD := PATH=/usr/bin:/bin:/sbin:$$PATH ninja -C $(MESON_OUT_DIR)/build
diff --git a/src/gallium/frontends/va/context.c b/src/gallium/frontends/va/context.c
--- a/src/gallium/frontends/va/context.c
+++ b/src/gallium/frontends/va/context.c
@@ -148,9 +148,6 @@
       break;
    }
 #else
-   case VA_DISPLAY_ANDROID:
-      FREE(drv);
-      return VA_STATUS_ERROR_UNIMPLEMENTED;
    case VA_DISPLAY_GLX:
    case VA_DISPLAY_X11:
 #ifdef GALLIUM_ZINK
@@ -163,6 +160,8 @@
          drv->vscreen = vl_xlib_swrast_screen_create(ctx->native_dpy, ctx->x11_screen);
       break;
    case VA_DISPLAY_WAYLAND:
+   /* Lepton: libva-android opens the render node into drm_state, as DRM does. */
+   case VA_DISPLAY_ANDROID:
    case VA_DISPLAY_DRM:
    case VA_DISPLAY_DRM_RENDERNODES: {
       const struct drm_state *drm_info = (struct drm_state *) ctx->drm_state;
