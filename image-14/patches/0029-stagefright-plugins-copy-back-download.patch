+            mConvSrcFmt != mFrame->format || mConvDstFmt != dstFmt || mConvThreads != threads) {
+        sws_freeContext(mImgConvertCtx);
+        mImgConvertCtx = sws_alloc_context();
+        if (!mImgConvertCtx ||
+                av_opt_set_int(mImgConvertCtx, "srcw", mFrame->width, 0) < 0 ||
+                av_opt_set_int(mImgConvertCtx, "srch", mFrame->height, 0) < 0 ||
+                av_opt_set_int(mImgConvertCtx, "src_format", mFrame->format, 0) < 0 ||
+                av_opt_set_int(mImgConvertCtx, "dstw", mFrame->width, 0) < 0 ||
+                av_opt_set_int(mImgConvertCtx, "dsth", mFrame->height, 0) < 0 ||
+                av_opt_set_int(mImgConvertCtx, "dst_format", dstFmt, 0) < 0 ||
+                av_opt_set_int(mImgConvertCtx, "sws_flags", SWS_BICUBIC, 0) < 0 ||
+                av_opt_set_int(mImgConvertCtx, "threads", threads, 0) < 0 ||
