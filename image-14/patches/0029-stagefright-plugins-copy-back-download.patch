+#if CONFIG_VAAPI
+// Lepton: how to download this session's frames. FFmpeg's map for reading
+// creates a VA image per frame and copies the surface into it (vaGetImage);
+// on Mesa that is a fresh 12 to 25 MB allocation and a single-threaded copy at
+// 4K. Mapping the surface itself (vaDeriveImage) reads Mesa's cached staging
+// copy directly. FFmpeg avoids derive for reading because on some drivers
+// (Intel's) the direct mapping is uncached, so auto uses it on Mesa only.
+void C2FFMPEGVideoDecodeComponent::decideCopyBack() {
+    AVHWFramesContext* hwfc = (AVHWFramesContext*)mFrame->hw_frames_ctx->data;
+    const char* vendor = vaQueryVendorString(((AVVAAPIDeviceContext*)hwfc->device_ctx->hwctx)->display);
+    const bool mesa = vendor && strncmp(vendor, "Mesa Gallium driver", 19) == 0;
+    mDeriveDownload = mCopyBackSetting == COPYBACK_DERIVE || (mCopyBackSetting == COPYBACK_AUTO && mesa);
+    mDeriveDecided = true;
+    ALOGI("LEPTON_VA_COPYBACK mode=%s setting=%s vendor=\"%s\"", mDeriveDownload ? "derive" : "map",
+          mCopyBackSetting == COPYBACK_AUTO ? "auto" : mCopyBackSetting == COPYBACK_MAP ? "map" : "derive",
+          vendor ? vendor : "?");
+}
+
+int C2FFMPEGVideoDecodeComponent::downloadFrameDerived() {
+    AVFrame* out = av_frame_alloc();
+    if (!out) return AVERROR(ENOMEM);
+    out->format = ((AVHWFramesContext*)mFrame->hw_frames_ctx->data)->sw_format;
+    // The mapping holds a reference to the surface until mFrame is unreferenced.
+    int err = av_hwframe_map(out, mFrame, AV_HWFRAME_MAP_READ | AV_HWFRAME_MAP_DIRECT);
+    if (err == 0) err = av_frame_copy_props(out, mFrame);
+    if (err < 0) {
+        av_frame_free(&out);
+        return err;
+    }
+    av_frame_unref(mFrame);
+    av_frame_move_ref(mFrame, out);
+    av_frame_free(&out);
+    return 0;
 }
+#endif
 
