+static void local_output_mode(void *data, struct wl_output *, uint32_t flags, int32_t width, int32_t height, int32_t refresh) {
+    auto o = static_cast<local_output *>(data);
+    if (!(flags & WL_OUTPUT_MODE_CURRENT)) return;
+    o->width = width; o->height = height;
+    o->owner->refresh = refresh;
+}
+static void local_output_done(void *data, struct wl_output *) {
+    auto o = static_cast<local_output *>(data);
+    for (auto &[key, window] : o->owner->windows) local_configure(window.get());
+}
+static void local_output_scale(void *data, struct wl_output *, int32_t scale) {
+    auto o = static_cast<local_output *>(data);
+    o->scale = std::max(1, scale);
+    if (!o->owner->has_fractional_scale) o->owner->preferred_scale = o->scale;
