+// SPDX-License-Identifier: MIT
+#pragma once
+#include <algorithm>
+#include <cmath>
+namespace lepton {
+// xdg configure dimensions are logical; wl_output current mode is physical.
+inline int pixel_extent(int logical, double scale) {
+    return std::max(1, static_cast<int>(std::lround(logical * scale)));
+}
+inline double axis_scale(int logical, int physical) {
+    return logical > 0 && physical > 0 ? double(physical) / logical : 1.0;
+}
+inline int input_coordinate(double logical, double scale) {
+    return static_cast<int>(logical * scale);
+}
+inline int logical_extent(int physical, double scale) {
+    return std::max(1, static_cast<int>(std::ceil(physical / scale - 1e-9)));
+}
+inline bool rotated_output(int transform) { return (transform & 1) != 0; }
+}
