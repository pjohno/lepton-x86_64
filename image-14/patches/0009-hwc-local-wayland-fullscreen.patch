+// All local dimensions come from acked surface configure plus the entered
+// output's current mode. No global max of unrelated output scales is used.
+static void local_configure(struct window *window) {
+    auto d = window->display;
+    if (!d->local_display || !window->configured) return;
+    std::scoped_lock lock(d->windowsMutex);
+    // A zero configure size lets the client choose. Retain the previous size,
+    // or use an output-based startup hint, never wait indefinitely for a size.
+    int hint_width = 1280, hint_height = 800;
+    for (auto &[id, o] : d->local_outputs) {
+        if ((o->output == window->local_output || d->local_outputs.size() == 1) && o->width > 0 && o->height > 0) {
+            hint_width = o->width; hint_height = o->height;
+            if (lepton::rotated_output(o->transform)) std::swap(hint_width, hint_height);
+            hint_width = lepton::pixel_extent(hint_width, 1.0 / d->preferred_scale);
+            hint_height = lepton::pixel_extent(hint_height, 1.0 / d->preferred_scale);
+            break;
+        }
+    }
+    int width = window->configured_width > 1 ? window->configured_width : (d->req_width > 1 ? d->req_width : hint_width);
+    int height = window->configured_height > 1 ? window->configured_height : (d->req_height > 1 ? d->req_height : hint_height);
+    int pw = lepton::pixel_extent(width, d->preferred_scale);
