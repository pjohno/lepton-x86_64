+				      DMA_BUF_SYNC_END | gbm_mesa_sync_access(vma->map_flags));
+		munmap(vma->addr, vma->length);
+		vma->priv = nullptr;
+		return 0;
+	}
 	assert(priv->gbm_bo != nullptr);
