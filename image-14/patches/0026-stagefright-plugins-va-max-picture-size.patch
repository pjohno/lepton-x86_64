-const std::string& C2FFMPEGVideoUtils::detectedHwCodecs() {
+static const VaCaps& detectedVaCaps() {
     static std::once_flag once;
-    static std::string codecs;
-    std::call_once(once, [] { codecs = queryVaCodecs(); });
-    return codecs;
+    static VaCaps caps;
+    std::call_once(once, [] { caps = queryVaCodecs(); });
+    return caps;
+}
+
+const std::string& C2FFMPEGVideoUtils::detectedHwCodecs() {
+    return detectedVaCaps().tokens;
+}
+
+bool C2FFMPEGVideoUtils::detectedHwMaxSize(const std::string& token, uint32_t* width, uint32_t* height) {
+    const VaCaps& caps = detectedVaCaps();
+    auto it = caps.maxSize.find(token);
+    if (it == caps.maxSize.end() || it->second.first == 0 || it->second.second == 0) {
+        return false;
+    }
+    *width = it->second.first;
+    *height = it->second.second;
+    return true;
 }
 
