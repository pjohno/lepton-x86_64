+// Lepton: the ro.waydroid.hwcodecs token for a media type ("" if none).
+static std::string vaToken(const char* mediaType) {
+    static const std::pair<const char*, const char*> kTokens[] = {
+        { MEDIA_MIMETYPE_VIDEO_AVC, "H264" }, { MEDIA_MIMETYPE_VIDEO_HEVC, "HEVC" },
+        { MEDIA_MIMETYPE_VIDEO_VP8, "VP80" }, { MEDIA_MIMETYPE_VIDEO_VP9, "VP90" },
+        { MEDIA_MIMETYPE_VIDEO_AV1, "AV10" }, { MEDIA_MIMETYPE_VIDEO_MPEG2, "MPG2" },
+        { MEDIA_MIMETYPE_VIDEO_MPEG4, "MPG4" }, { MEDIA_MIMETYPE_VIDEO_H263, "H263" },
+    };
+    for (const auto& t : kTokens) {
+        if (strcasecmp(mediaType, t.first) == 0) return t.second;
+    }
+    return "";
+}
+
+// Lepton: the largest picture this decoder takes. With hardware decoding on
+// and the codec decoded by VA, that is the VA driver's maximum (up to 8K on
+// current GPUs); otherwise kMaxDimension, as before.
+static void maxPictureSize(const char* mediaType, uint32_t* width, uint32_t* height) {
+    *width = *height = kMaxDimension;
+    if (!base::GetBoolProperty("media.sf.hwaccel", false)) {
+        return;
+    }
+    const std::string token = vaToken(mediaType);
+    std::string codecs = base::GetProperty("ro.waydroid.hwcodecs", "");
+    if (codecs.empty()) {
+        codecs = C2FFMPEGVideoUtils::detectedHwCodecs();
+    }
+    uint32_t w, h;
+    if (!token.empty() && (" " + codecs + " ").find(" " + token + " ") != std::string::npos
+            && C2FFMPEGVideoUtils::detectedHwMaxSize(token, &w, &h)) {
+        *width = w;
+        *height = h;
+    }
+}
+
+// Lepton: level 5.x allows at most this many luma samples per picture
+// (H.264: 36864 macroblocks; HEVC, VP9 and AV1: 8912896). A larger maximum
+// from VA adds level 6. Not 6.1/6.2: VA reports no frame rate.
+static bool beyondLevel5(uint32_t width, uint32_t height, uint64_t level5Samples) {
+    return (uint64_t)width * height > level5Samples;
+}
