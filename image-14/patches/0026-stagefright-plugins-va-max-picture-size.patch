+struct VaCaps {
+    std::string tokens;
+    std::map<std::string, std::pair<uint32_t, uint32_t>> maxSize;
+};
+
+#if CONFIG_VAAPI
+// Largest surface the driver decodes for profile (0x0 when not reported).
+static std::pair<uint32_t, uint32_t> queryVaMaxSize(VADisplay display, VAProfile profile) {
+    std::pair<uint32_t, uint32_t> size(0, 0);
+    VAConfigID config;
+    if (vaCreateConfig(display, profile, VAEntrypointVLD, nullptr, 0, &config) != VA_STATUS_SUCCESS) {
+        return size;
+    }
+    unsigned int count = 0;
+    if (vaQuerySurfaceAttributes(display, config, nullptr, &count) == VA_STATUS_SUCCESS && count > 0) {
+        std::vector<VASurfaceAttrib> attribs(count);
+        if (vaQuerySurfaceAttributes(display, config, attribs.data(), &count) == VA_STATUS_SUCCESS) {
+            for (unsigned int i = 0; i < count; i++) {
+                if (attribs[i].value.type != VAGenericValueTypeInteger) continue;
+                if (attribs[i].type == VASurfaceAttribMaxWidth) {
+                    size.first = attribs[i].value.value.i;
+                } else if (attribs[i].type == VASurfaceAttribMaxHeight) {
+                    size.second = attribs[i].value.value.i;
+                }
+            }
+        }
+    }
+    vaDestroyConfig(display, config);
+    return size;
+}
+#endif
