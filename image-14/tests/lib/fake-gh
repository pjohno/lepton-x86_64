#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Stand-in for the GitHub CLI (gh) used by test-publish-release.sh.

Keeps releases in $FAKE_GH_STATE (JSON) and logs every call to $FAKE_GH_LOG.
Supports only the calls publish-release.sh makes. FAKE_GH_AUTH=1 fails
'gh auth status'; FAKE_GH_TRUNCATE=NAME uploads NAME incompletely (as an
interrupted upload would); FAKE_GH_NO_DIGEST=1 omits asset digests."""
import hashlib
import json
import os
import sys

STATE = os.environ["FAKE_GH_STATE"]
REPO = "pjohno/lepton-x86_64"
args = sys.argv[1:]
with open(os.environ["FAKE_GH_LOG"], "a", encoding="utf-8") as log:
    log.write(" ".join(args) + "\n")
state = json.load(open(STATE)) if os.path.exists(STATE) else {"releases": [], "next_id": 1}


def save():
    json.dump(state, open(STATE, "w"), indent=1)


def option(name, default=None):
    return args[args.index(name) + 1] if name in args else default


def find(tag):
    return next((r for r in state["releases"] if r["tag_name"] == tag), None)


def die(message, code=1):
    print(message, file=sys.stderr)
    sys.exit(code)


if args[:2] == ["auth", "status"]:
    sys.exit(1 if os.environ.get("FAKE_GH_AUTH") == "1" else 0)
if args[0] == "api":
    path = next(a for a in args[1:] if not a.startswith("-") and a not in (option("--jq"),))
    if path == "repos/" + REPO:
        print(REPO)
        sys.exit(0)
    if path.startswith("repos/%s/releases" % REPO):
        for release in state["releases"]:
            print(json.dumps(release))
        sys.exit(0)
    die("fake gh: unsupported api " + path)
if args[:2] == ["release", "create"]:
    tag = args[2]
    if find(tag):
        die("a release with the same tag name already exists: " + tag)
    state["releases"].append(dict(
        id=state["next_id"], tag_name=tag, draft="--draft" in args, prerelease="--prerelease" in args,
        target_commitish=option("--target"), name=option("--title"),
        body=open(option("--notes-file")).read(), assets=[],
        html_url="https://github.com/%s/releases/tag/untagged-%d" % (REPO, state["next_id"])))
    state["next_id"] += 1
    save()
    sys.exit(0)
if args[:2] == ["release", "upload"]:
    release = find(args[2])
    if release is None:
        die("release not found")
    files = [a for a in args[3:] if not a.startswith("--") and a != option("--repo")]
    for path in files:
        name = os.path.basename(path)
        existing = next((a for a in release["assets"] if a["name"] == name), None)
        if existing and "--clobber" not in args:
            die("asset under the same name already exists: " + name)
        if existing:
            release["assets"].remove(existing)
        data = open(path, "rb").read()
        asset = dict(name=name, size=len(data), state="uploaded")
        if os.environ.get("FAKE_GH_TRUNCATE") == name:
            asset.update(size=len(data) // 2, state="new")
            data = data[: len(data) // 2]
        if os.environ.get("FAKE_GH_NO_DIGEST") != "1":
            asset["digest"] = "sha256:" + hashlib.sha256(data).hexdigest()
        release["assets"].append(asset)
    save()
    sys.exit(0)
if args[:2] == ["release", "edit"]:
    release = find(args[2])
    if release is None:
        die("release not found")
    for arg in args[3:]:
        if arg.startswith("--draft="):
            release["draft"] = arg.endswith("=true")
        if arg.startswith("--prerelease="):
            release["prerelease"] = arg.endswith("=true")
        if arg.startswith("--latest="):
            release["latest"] = arg.endswith("=true")
    if not release["draft"]:
        release["published_at"] = "2026-11-06T12:00:00Z"
        release["html_url"] = "https://github.com/%s/releases/tag/%s" % (REPO, release["tag_name"])
    save()
    sys.exit(0)
if args[:2] == ["release", "view"]:
    release = find(args[2])
    if release is None:
        die("release not found")
    print(release["html_url"])
    sys.exit(0)
die("fake gh: unsupported command: " + " ".join(args))
